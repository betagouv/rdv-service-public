= render "search/banner", context: OpenStruct.new(public_link_organisation: @rdv_invitation.organisation)

.fr-container
  section.fr-py-3w.fr-col-12.fr-col-lg-10.fr-col-offset-lg-1
    p.fr-text--lg #{@rdv_invitation.organisation.name} vous invite à prendre rendez-vous pour le motif <b>#{@rdv_invitation.motif.name}</b>.

    p.fr-text--lg
      = render "details", rdv_invitation: @rdv_invitation
    p.fr-text--lg Choisissez un créneau:

    .card
      .card-body
        = render "search/creneaux", creneau_selection_service: @creneau_selection_service
