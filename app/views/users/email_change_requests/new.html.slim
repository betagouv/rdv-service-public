- content_for :title, "Changer d’adresse email"

.fr-container.fr-pt-3w
  = dsfr_breadcrumbs do |b|
    = b.with_breadcrumb label: "Accueil", href: root_path
    = b.with_breadcrumb label: "Mes informations", href: users_informations_path
    = b.with_breadcrumb label: "Changer d’adresse email"

  .fr-grid-row
    .fr-col-12.fr-col-md-6
      h1
        | Changer d’adresse email

      = render "model_errors", model: @email_change_request_form

      p
        |> Votre adresse email actuelle est
        b= "#{current_user.email}."

      p
        |> Renseignez votre nouvelle adresse email.
        | Un code de confirmation à 6 chiffres vous sera envoyé à cette adresse.

      = form_for @email_change_request_form, url: email_change_request_path, method: :post, builder: Dsfr::FormBuilder, as: :email_change_request_form do |f|
        = f.dsfr_email_field :email, label: "Nouvelle adresse email", required: true
        ul.fr-btns-group.fr-btns-group--inline-md.fr-btns-group--right.rdv-flex-wrap-wrap-reverse
          li
            = link_to "Annuler", users_informations_path, class: "fr-btn fr-btn--secondary"
          li
            = f.submit "Recevoir un code de confirmation", class: "fr-btn"
