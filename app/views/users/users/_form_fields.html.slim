= render "model_errors", model: f.object, f: f

.fr-grid-row.fr-grid-row--gutters.fr-mb-3v
  .fr-col-12.fr-col-md-6= f.dsfr_text_field :first_name, disabled: f.object.first_name_frozen?, autocomplete: "given-name"
  .fr-col-12.fr-col-md-6= f.dsfr_text_field :last_name, disabled: f.object.last_name_frozen?, autocomplete: "family-name"

.fr-grid-row.fr-grid-row--gutters.fr-mb-3v
  - if f.object.show_birth_name_field?
    .fr-col-12.fr-col-md-6= f.dsfr_text_field :birth_name, placeholder: "Nom de naissance", disabled: f.object.birth_name_frozen?
  - if f.object.show_birth_date_field?
    .fr-col-12.fr-col-md-6= f.dsfr_text_field :birth_date, type: "date", disabled: f.object.birth_date_frozen?, autocomplete: "bday"

- if f.object.show_ants_pre_demande_number_field?
  = f.dsfr_text_field :ants_pre_demande_number,
    required: true,
    hint: t("simple_form.hints.user.ants_pre_demande_number_html"),
    style: "text-transform: uppercase;"

- if f.object.show_franceconnect_frozen_fields_warning?
  .fr-alert.fr-alert--info.fr-mb-1w
    = I18n.t("users.franceconnect_frozen_fields")

- if f.object.show_email_field?
  = f.dsfr_email_field :email, disabled: f.object.email_disabled?, required: true, autocomplete: "email"

- elsif f.object.show_notification_email_field?
  = f.dsfr_email_field :notification_email, label: f.object.notification_email_label, required: f.object.notification_email_required?

= f.dsfr_phone_field :phone_number, as: :tel, required: f.object.phone_required?, autocomplete: "tel"
- if f.object.show_landline_phone_number_warning?
  .fr-alert.fr-alert--warning.fr-mb-1w Vous ne recevrez pas de SMS avec ce numéro non-mobile

div.mb-2 Préférences de notifications
div= f.dsfr_check_box :notify_by_email
div= f.dsfr_check_box :notify_by_sms

- if f.object.show_address_field?
  = f.dsfr_text_field :address,
    value: f.object.address_value,
    required: f.object.address_required?,
    data: { "address-autocomplete": "on" },
    autocomplete: "street-address",
    dir: "ltr"

- if f.object.show_address_details_field?
  = f.dsfr_text_field :address_details

= f.hidden_field :city_code
= f.hidden_field :post_code
= f.hidden_field :city_name

- if f.object.show_social_fields?
  - if f.object.show_caisse_affiliation_field? || f.object.show_affiliation_number_field?
    .fr-grid-row.fr-grid-row--gutters.fr-mb-3v
      - if f.object.show_caisse_affiliation_field?
        .fr-col-12.fr-col-md-6= f.dsfr_select :caisse_affiliation, User.human_attribute_values(:caisse_affiliation), include_blank: true
      - if f.object.show_affiliation_number_field?
        .fr-col-12.fr-col-md-6= f.dsfr_text_field :affiliation_number

  - if f.object.show_logement_field?
    = f.dsfr_select :logement, User.human_attribute_values(:logement), include_blank: true
