ruby:
  rdv_wizard = local_assigns[:rdv_wizard]
  form_url = rdv_wizard.present? ? users_rdv_wizard_step_path(step: 1, **@rdv_wizard.to_query.except(:rdv)) : users_informations_path
  form_method = rdv_wizard.present? ? "post" : "patch"

= form_for form_object, as: :user, url: form_url, method: form_method, builder: Dsfr::FormBuilder do |f|
  = render "model_errors", model: form_object, f: f
  .fr-grid-row.fr-grid-row--gutters.fr-mb-3v
    .fr-col-12.fr-col-md-6= f.dsfr_text_field :first_name, disabled: form_object.first_name_frozen?, autocomplete: "given-name"
    .fr-col-12.fr-col-md-6= f.dsfr_text_field :last_name, disabled: form_object.last_name_frozen?, autocomplete: "family-name"
  .fr-grid-row.fr-grid-row--gutters.fr-mb-3v
    - if form_object.show_birth_name_field?
      .fr-col-12.fr-col-md-6= f.dsfr_text_field :birth_name, placeholder: "Nom de naissance", disabled: form_object.birth_name_frozen?
    - if form_object.show_birth_date_field?
      .fr-col-12.fr-col-md-6= f.dsfr_text_field :birth_date, type: "date", disabled: form_object.birth_date_frozen?, autocomplete: "bday"
  - if form_object.show_ants_pre_demande_number_field?
    = f.dsfr_text_field :ants_pre_demande_number, required: true, hint: t("simple_form.hints.user.ants_pre_demande_number_html"), style: "text-transform: uppercase;"
  - if form_object.show_franceconnect_frozen_fields_warning?
    .fr-alert.fr-alert--info.fr-mb-1w
      = I18n.t("users.franceconnect_frozen_fields")
  - if form_object.show_email_field?
    = f.dsfr_email_field :email, disabled: form_object.email_disabled?, required: true, autocomplete: "email"
  - elsif form_object.show_notification_email_field?
    = f.dsfr_email_field :notification_email, label: form_object.notification_email_label, required: form_object.notification_email_required?

  = f.dsfr_phone_field :phone_number, as: :tel, required: form_object.phone_required?, autocomplete: "tel"
  - if form_object.show_landline_phone_number_warning?
    .fr-alert.fr-alert--warning.fr-mb-1w Vous ne recevrez pas de SMS avec ce numéro non-mobile
  div.mb-2 Préférences de notifications
  div= f.dsfr_check_box :notify_by_email
  div= f.dsfr_check_box :notify_by_sms
  - if form_object.show_address_field?
    = f.dsfr_text_field :address, value: form_object.address_value, required: form_object.address_required?, data: { "address-autocomplete": "on" }, autocomplete: "street-address", dir: "ltr"

  - if form_object.show_address_details_field?
    = f.dsfr_text_field :address_details

  = f.hidden_field :city_code
  = f.hidden_field :post_code
  = f.hidden_field :city_name

  - if form_object.show_social_fields?
    - if form_object.show_caisse_affiliation_field? || form_object.show_affiliation_number_field?
      .fr-grid-row.fr-grid-row--gutters.fr-mb-3v
        - if form_object.show_caisse_affiliation_field?
          .fr-col-12.fr-col-md-6= f.dsfr_select :caisse_affiliation, User.human_attribute_values(:caisse_affiliation), include_blank: true
        - if form_object.show_affiliation_number_field?
          .fr-col-12.fr-col-md-6= f.dsfr_text_field :affiliation_number

    - if form_object.show_logement_field?
      = f.dsfr_select :logement, User.human_attribute_values(:logement), include_blank: true

  - if rdv_wizard.present?
    - rdv_wizard.to_query.each do |wizard_key, wizard_value|
      = hidden_field_tag "rdv[#{wizard_key}]", wizard_value

    .fr-grid-row.fr-grid-row--gutters.fr-mt-3w
      .fr-col.rdv-justify-content-space-between.d-flex.flex-row-aligned
        = link_to "Revenir en arrière", prendre_rdv_path(rdv_wizard.to_query), class: "fr-icon-arrow-left-line fr-btn--icon-left fr-btn fr-btn--tertiary-no-outline"
        = f.submit "Continuer", class: "fr-btn"

  - else
    .rdv-text-align-right
      = f.submit "Enregistrer", class: "fr-btn"
