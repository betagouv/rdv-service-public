ul.fr-raw-list.fr-mb-3w.fr-mt-0
  li.fr-mb-4w
    h2.fr-h6.fr-mb-1w
      span.fr-icon-calendar-event-fill.fr-mr-1w[aria-hidden="true"]
      | Date et heure
      = rdv_tag(rdv)
    - if rdv.starts_at.to_date.today?
      = t("rdvs.date_today", starts_at: l(rdv.starts_at, format: :time_only))
    - else
      = t("rdvs.date", starts_at: l(rdv.starts_at, format: :human))
    div
      = t("rdvs.duration", duration: rdv.duration_in_min)

  - if rdv.motif.restriction_for_rdv.present?
    li.fr-mb-4w
      h2.fr-h6.fr-mb-1w
        span.fr-icon-warning-fill.fr-mr-1w[aria-hidden="true"]
        | Consignes
      = auto_link_text(rdv.motif.restriction_for_rdv)

  - if rdv.home?
    li.fr-mb-4w
      h2.fr-h6.fr-mb-1w
        span.fr-icon-home-4-fill.fr-mr-1w[aria-hidden="true"]
        | Lieu
      | À domicile

  - elsif rdv.public_office?
    li.fr-mb-4w
      h2.fr-h6.fr-mb-1w
        span.fr-icon-map-pin-2-fill.fr-mr-1w[aria-hidden="true"]
        | Lieu
      = human_location(rdv)
      - if rdv.lieu&.phone_number.present?
        .fr-mt-1w
          span.fr-icon-phone-fill.fr-mr-1w[aria-hidden="true"]
          = link_to rdv.lieu.phone_number, "tel:#{rdv.lieu.phone_number_formatted}"

  - elsif rdv.phone?
    li.fr-mb-4w
      h2.fr-h6.fr-mb-1w
        span.fr-icon-phone-fill.fr-mr-1w[aria-hidden="true"]
        | RDV Téléphonique
      | RDV Téléphonique
      .fr-mt-1w
        - if current_user.signed_in_with_restricted_auth_token?
          | L'agent vous appellera au numéro que vous lui avez indiqué.
        - else
          | L'agent vous appellera au #{current_user.phone_number}.

  - elsif rdv.motif.visio?
    li.fr-mb-4w
      h2.fr-h6.fr-mb-1w
        span.fr-icon-video-chat-fill.fr-mr-1w[aria-hidden="true"]
        | Visioconférence
      - if rdv.starts_at.to_date > Time.zone.today
        = t("rdvs.visio_link_available_on_rdv_day")
      - elsif rdv.visio_url.present?
        = link_to("rejoindre la visioconférence", rdv.visio_url, target: :_blank)
      - else
        = t("rdvs.visio_link_not_yet_available")

  li.fr-mb-4w
    h2.fr-h6.fr-mb-1w
      - if rdv.users.count > 1
        span.fr-icon-group-fill.fr-mr-1w[aria-hidden="true"]
      - else
        span.fr-icon-user-fill.fr-mr-1w[aria-hidden="true"]
      = t("rdvs.participants_title", count: rdv.users.count)
    = users_to_sentence(rdv.users)
    - if policy(rdv, policy_class: User::RdvPolicy).can_change_participants?
      .fr-mt-1w
        = link_to "modifier", users_rdv_participations_path(rdv)

  - if @can_see_rdv_motif
    li.fr-mb-4w
      h2.fr-h6.fr-mb-1w
        span.fr-icon-booklet-fill.fr-mr-1w[aria-hidden="true"]
        | Motif
      = rdv.motif_name

  - if rdv.motif.instruction_for_rdv.present?
    li.fr-mb-4w
      h2.fr-h6.fr-mb-1w
        span.fr-icon-information-fill.fr-mr-1w[aria-hidden="true"]
        | Informations
      = auto_link_text(rdv.motif.instruction_for_rdv)

  = render "/users/rdvs/file_attente", rdv: rdv

  / Check for authorizations and already cancelled rdv/participation
  - unless policy(rdv, policy_class: User::RdvPolicy).cancel? || \
      policy(current_user.participation_for(rdv), policy_class: User::ParticipationPolicy).cancel? || \
      rdv.cancelled? || \
      current_user.participation_for(rdv).cancelled? || \
      rdv.in_the_past?
    li.fr-mb-4w
      span.fr-icon-close-circle-fill.fr-mr-1w[aria-hidden="true"]
      | Ce rendez-vous n'est pas annulable en ligne. Prenez contact avec le secrétariat.

= render "/users/organisations/contact_info", phone_number: rdv.phone_number, organisation: rdv.organisation

ul.fr-btns-group.fr-btns-group--inline.fr-btns-group--icon-left.fr-mb-0
  - if policy(rdv, policy_class: User::RdvPolicy).edit?
    li
      = link_to "Déplacer le RDV", creneaux_users_rdv_path(rdv), class: "fr-btn fr-btn--tertiary"
  - if policy(rdv, policy_class: User::RdvPolicy).cancel?
    li
      button.fr-btn.fr-btn--tertiary[data-fr-opened="false" aria-controls="js-cancel-rdv-modal-#{rdv.id}"] Annuler le RDV
  - if policy(current_user.participation_for(rdv), policy_class: User::ParticipationPolicy).cancel?
    li
      button.fr-btn.fr-btn--tertiary[data-fr-opened="false" aria-controls="js-cancel-participation-modal-#{rdv.id}"] Annuler votre participation
  - unless rdv.cancelled? || rdv.in_the_past?
    li
      button.fr-btn.fr-btn--tertiary.fr-btn--icon-left.fr-icon-calendar-line[data-fr-opened="false" aria-controls="js-add-to-calendar-modal-#{rdv.id}"] Ajouter à mon calendrier

- unless rdv.cancelled? || rdv.in_the_past?
  dialog.fr-modal id="js-add-to-calendar-modal-#{rdv.id}" role="dialog" aria-labelledby="js-add-to-calendar-modal-#{rdv.id}-title" data-fr-concealing-backdrop="true"
    .fr-container.fr-container--fluid.fr-container-md
      .fr-grid-row.fr-grid-row--center
        .fr-col-12.fr-col-md-8.fr-col-lg-6
          .fr-modal__body
            .fr-modal__header
              button.fr-btn--close.fr-btn aria-controls="js-add-to-calendar-modal-#{rdv.id}" aria-label="Fermer" data-dismiss="modal" type="button" Fermer
            .fr-modal__content
              h2.fr-modal__title id="js-add-to-calendar-modal-#{rdv.id}-title" Ajouter à mon calendrier
              - add_to_calendar = AddRdvToCalendar.new(rdv, current_user)
              ul.fr-raw-list
                li= link_to "Google", add_to_calendar.google_url, target: :_blank
                li= link_to "Apple Calendrier", add_to_calendar.ical_url, target: :_blank
                li= link_to "Outlook", add_to_calendar.outlook_com_url, target: :_blank
                li= link_to "Office 365", add_to_calendar.office365_url, target: :_blank
                li= link_to "Télécharger l'ICS", ics_users_rdv_path(rdv)
            .fr-modal__footer
              button.fr-btn.fr-btn--secondary data-dismiss="modal" type="button" aria-controls="js-add-to-calendar-modal-#{rdv.id}" Fermer

= render( \
        "common/modal_confirmation", \
        id: "js-cancel-rdv-modal-#{rdv.id}", \
        body_message: rdv.motif.cancellation_warning, \
        cancel_message: "Non", \
        confirm_path: cancel_users_rdv_path(rdv), \
        confirm_message: "Oui, annuler le rendez-vous", \
        confirm_link_options: { method: :put } \
)

= render( \
        "common/modal_confirmation", \
        id: "js-cancel-participation-modal-#{rdv.id}", \
        body_message: rdv.motif.cancellation_warning, \
        cancel_message: "Non", \
        confirm_path: users_rdv_participations_cancel_path(rdv), \
        confirm_message: "Oui, annuler votre participation", \
        confirm_link_options: { method: :put } \
)
