/# locals: (phone_number:, organisation:)
- if phone_number.present? || organisation.website.present?
  .fr-mb-2w
    h2.fr-h6.fr-mt-3w Contact de #{organisation.name}
    .rdv-display-flex.rdv-flex-wrap-wrap.rdv-gap-1rem
      - if phone_number.present?
        p.fr-mb-0
          span.fr-icon-phone-fill.fr-mr-1w[aria-hidden="true"]
          = phone_to(phone_number, title: "Numéro de téléphone")
      - if organisation.website_url.present?
        p.fr-mb-0
          span.fr-icon-global-fill.fr-mr-1w[aria-hidden="true"]
          = link_to "Site web", organisation.website_url, target: "_blank"
