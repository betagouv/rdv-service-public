- content_for(:title, @rdv_wizard.present? ? "Votre identité" : "Connexion")
.card
  = render "users/rdv_wizard_steps/rdv_wizard_summary", rdv_wizard: @rdv_wizard if @rdv_wizard.present?

  ruby:
    organisation = @rdv_wizard&.rdv&.motif&.organisation
    for_particuliers = organisation&.online_booking_for_particuliers
    for_professionnels = organisation&.online_booking_for_professionnels
    only_sso = organisation&.online_booking_only_sso?

  .card-body
    - if @rdv_wizard.nil? || for_particuliers
      - if display_france_connect_v2_button?
        = render "common/franceconnect_button", display_title: false
        / On affiche le « ou » si le formulaire d’identification par email est activé ou si le bouton ProConnect est affiché
        - if !only_sso || (display_pro_connect_button? && for_professionnels)
          p.fr-hr-or ou

    / Contrairement à FranceConnect, on n'affiche pas le bouton ProConnect en dehors de la prise de rendez-vous
    - if display_pro_connect_button? && for_professionnels
      .rdv-text-align-center
        = render "common/proconnect_button_dsfr", user_type: "user"
      - unless only_sso
        p.fr-hr-or ou

    - unless only_sso
      = form_for @login_code_request_form, url: users_login_codes_path, method: :post, builder: Dsfr::FormBuilder, as: :login_code_request_form do |f|
        = render "model_errors", model: @login_code_request_form, form: f
        - if @rdv_wizard
          = hidden_field_tag :behaviour, "upsert_user"
          .fr-grid-row.fr-grid-row--gutters.fr-mb-2w
            .fr-col-12.fr-col-md-6
              = f.dsfr_text_field :first_name, required: true, label: "Prénom", autocomplete: "given-name"
            .fr-col-12.fr-col-md-6
              = f.dsfr_text_field :last_name, required: true, label: "Nom", autocomplete: "family-name"
        = f.dsfr_email_field :email, hint: "Format attendu : nom@domaine.fr", required: true, label: "Adresse email", autocomplete: "email"
        .rdv-text-align-center
          = f.submit "Recevoir un code de connexion", class: "fr-mt-2v fr-btn rdv-width-100 rdv-width-md-auto"
          - if @login_code_request_form.errors[:base].any? { _1.to_s.match(/Un code a été envoyé .* il y a moins de deux minutes/) }
            .fr-my-2w
              = link_to "Saisir un code reçu", new_users_sessions_by_code_path(email: @login_code_request_form.email), class: "fr-btn fr-btn--secondary"
          - unless @rdv_wizard
            .fr-mt-4w.fr-mb-2w.fr-text--sm
              |> Vous n'avez pas de compte ?
              = link_to "Je m'inscris", new_user_registration_path

      - if @rdv_wizard
        p.fr-hr-or.fr-mt-16w ou
        .rdv-text-align-center.rdv-color-text-mention-grey
          = link_to prescripteur_start_path(@rdv_wizard.to_query) do
            b Je suis un prescripteur qui oriente un bénéficiaire
