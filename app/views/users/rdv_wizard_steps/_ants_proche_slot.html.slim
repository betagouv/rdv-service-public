/! Section proches ANTS (plusieurs pré-demandes)
/! L'usager courant est toujours inclus dans le RDV. Ce formulaire permet de sélectionner les proches additionnels.
ruby:
  relatives = current_user.relatives.order(:first_name)
  selected_ids = @rdv_booking_form.ants_selected_relative_ids

.fr-mt-3w
  h3.fr-h5.fr-mt-4w Proches

  /! Proches existants
  - if relatives.any? || @rdv_booking_form.new_ants_proches.any?
    fieldset.fr-fieldset
      legend.fr-fieldset__legend--regular.fr-fieldset__legend Sélectionnez les proches à inclure dans le RDV

      - relatives.each do |relative|
        .fr-fieldset__element.fr-p-2w.fr-mb-1w
          .fr-checkbox-group
            = check_box_tag "user[ants_selected_relative_ids][]", relative.id.to_s, selected_ids.include?(relative.id.to_s), id: "ants_relative_#{relative.id}"
            = label_tag "ants_relative_#{relative.id}", relative.full_name
          = f.fields_for :relatives, [relative], index: "r#{relative.id}" do |rf|
            = rf.hidden_field :id
            .fr-grid-row.fr-grid-row--gutters.fr-mt-1w
              .fr-col-md-6= rf.dsfr_text_field :ants_pre_demande_number, label: "Numéro de pré-demande ANTS"

      - new_proche_number = 0
      = f.fields_for :relatives, @rdv_booking_form.new_ants_proches do |rf|
        - new_proche_number += 1
        .fr-p-2w.fr-mb-1w
          p.fr-text--bold Nouveau proche #{new_proche_number}
          .fr-grid-row.fr-grid-row--gutters
            .fr-col-md-6= rf.dsfr_text_field :first_name, label: "Prénom"
            .fr-col-md-6= rf.dsfr_text_field :last_name, label: "Nom"
            - if @rdv_booking_form.show_birth_date_field?
              .fr-col-md-6= rf.dsfr_text_field :birth_date, type: "date", label: "Date de naissance"
            .fr-col-md-6= rf.dsfr_text_field :ants_pre_demande_number, label: "Numéro de pré-demande ANTS"
