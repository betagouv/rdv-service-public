- content_for :title, "Formulaire de contact"

- content_for :breadcrumbs do
  = dsfr_breadcrumbs do |b|
    = b.breadcrumb label: "Contact", href: aide_aiguillage_role_path
    - if @form.role_usager?
      = b.breadcrumb label: "Aide usagers", href: aide_aiguillage_usager_path
    = b.breadcrumb label: yield(:title)

.fr-grid-row.fr-mb-4w
  .fr-col-12.fr-col-md-8
    = form_for @form, url: aide_demande_support_path, method: :POST, builder: DsfrFormBuilder do |f|
      = f.dsfr_select :role,
        [["Vous êtes usager", :usager], ["Vous êtes agent du service public", :agent]],
        value: @form.role,
        label: "Vous êtes…",
        required: true
      = f.dsfr_text_field :sujet, value: @form.sujet, label: "La raison de votre message", required: true
      - if @form.role_usager?
        .fr-callout.fr-my-2w
          | L’équipe RDV Service Public n’est pas en mesure de traiter tous les éléments concernant le rendez-vous (transmissions de documents, prise et annulation de rendez-vous et/ou ouverture des créneaux).
      = f.dsfr_text_area :message, rows: 5, label: "Votre message", required: true
      .fr-grid-row.fr-grid-row--gutters.fr-mb-2w
        .fr-col-12.fr-col-md-6
          = f.dsfr_text_field :first_name, label: "Votre prénom", required: true
        .fr-col-12.fr-col-md-6
          = f.dsfr_text_field :last_name, label: "Votre nom de famille", required: true
      .fr-grid-row.fr-grid-row--gutters.fr-mb-2w
        .fr-col-12.fr-col-md-6
          = f.dsfr_email_field :email, label: "Votre email", required: true
        .fr-col-12.fr-col-md-6
          = f.dsfr_phone_field :phone_number, label: "Votre numéro de téléphone (facultatif)"

      ul.fr-btns-group.fr-btns-group--inline
        li
          = link_to "Annuler",
            @form.role_usager? ? aide_aiguillage_usager_path : root_path,
            class: "fr-btn fr-btn--secondary"
        li
          = f.submit "Envoyer votre demande", class: "fr-btn"
