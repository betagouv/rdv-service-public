- content_for :title, t(".title")

- if @auto_download_export
  / Relance automatiquement le téléchargement, sans JS, une fois revenu sur cette page après la
  / vérification du 2FA (voir Agents::TwoFactorFreshnessConcern#redirect_after_two_factor_verification!)
  meta http-equiv="refresh" content="0; url=#{agents_export_download_path(@auto_download_export.id)}"

- if @exports.any?
  .row.my-4
    .col-md-12
      .fr-text-mention--grey.font-14
        |> Vous trouverez ci-dessous les exports réalisés au cours de ces deux dernières semaines.
        => "Les liens de téléchargement expirent chaque soir à minuit."
        |> Si le lien a expiré, vous pouvez générer un nouvel export à partir de la
        = link_to("liste des RDV", admin_organisation_rdvs_path(organisation_id: current_agent.organisations.ordered_by_name.first.id))
        | .

  table.table.table-sm
    tbody
      - @exports.each do |export|
        tr
          td.align-middle
            = export.to_s
            br
            .fr-text-mention--grey
              = export.organisation_ids.map { Organisation.find(_1).name }.join(", ")
          td.align-middle
            .text-right
              - if export.available?
                = link_to agents_export_download_path(export.id), class: "fr-btn fr-btn-sm fr-btn--tertiary fr-icon-download-line fr-btn--icon-left", style: "white-space: nowrap", target: "_blank" do
                  | Télécharger
              - else
                .d-block= render partial: "agents/exports/export_badge", locals: { export: export }

- else
  .rdv-text-align-center.py-2 Vous n'avez aucun export
