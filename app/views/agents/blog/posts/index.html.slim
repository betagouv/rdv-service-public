turbo-frame#blog-posts
  - if @posts.any?
    ul.fr-raw-list
      - @posts.each do |post|
        li.m-2
          = render partial: "agents/blog/posts/post", locals: { post: post }
    .m-2
      = dsfr_link_to("Voir toutes les nouveautés", blog_posts_path, target: "_blank", title: "Voir toutes les nouveautés - nouvelle fenêtre")
  - else
    .m-2 Aucune nouveauté
