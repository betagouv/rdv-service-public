.fr-row.justify-content-md-center.fr-mb-16w
  .fr-col-12
    = render "agents/rdv_plans/header", rdv_plan: @rdv_plan, current_step: 2, step_title: "Motif", next_step_title: "Usager"
    .card
      .card-body
        span.fr-icon-calendar-fill.fr-mr-1w[aria-hidden="true"]
        = "#{l(@rdv_plan.starts_at, format: :human)} (#{@rdv_plan.duration_in_minutes} minutes)"
        = link_to "modifier", edit_creneau_agents_rdv_plan_path(@rdv_plan), class: "fr-ml-2w"
        = render "agents/rdv_plans/location_type_recap", rdv_plan: @rdv_plan
        hr.fr-mt-2w

        = simple_form_for @rdv_plan, url: (update_motif_from_calendar_agents_rdv_plan_path(@rdv_plan)) do |f|
          = render "model_errors", model: @rdv_plan

          = f.input :motif_id, \
            label: "Motif du rendez-vous", \
              required: true, \
              include_blank: true, \
              collection: @motifs, \
              label_method: -> { "#{_1.name} #{'- RDV collectif ' if _1.collectif?}" }, \
              input_html: { \
                data: { placeholder: "Sélectionnez un motif", "auto-select-sole-option": true },
                class: "select2-input", \
              }

          = f.submit "Continuer", class: "fr-btn float-right"
