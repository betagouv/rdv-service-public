/# locals: (event_sources:)

.fr-row.fr-mb-16w[data-controller="rdv-plan" data-rdv-plan-id="#{@rdv_plan.id}"]
  .fr-col-12
    = render "agents/rdv_plans/header", rdv_plan: @rdv_plan, current_step: 1, step_title: "Créneau", next_step_title: "Motif"

    h2.fr-h3 Calendrier de #{current_agent.full_name}
    .fr-select-group
      select.fr-select[data-action="change->rdv-plan#updateAgent"]
        option[value="#{current_agent.id}"] #{current_agent.full_name}
        - @other_agents.each do |agent|
          option[value="#{agent.id}"] #{agent.full_name}
    p Convenez d'un horaire avec #{@rdv_plan.user.full_name}, et cliquez dessus dans le calendrier
    = render "agents/rdv_plans/calendar", event_sources:, rdv_plan: @rdv_plan, single_day: false
    - if @rdv_plan.return_url
      = link_to @rdv_plan.return_url do
        = back_icon(class: "fr-mr-1w")
        = "Retour sur #{@rdv_plan.oauth_application.name}"
