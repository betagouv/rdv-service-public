.fr-row.fr-mb-16w
  .fr-col-12
    = render "agents/rdv_plans/header", rdv_plan: @rdv_plan, current_step: 1, step_title: "Motif", next_step_title: "Créneau"

    p Pour quel motif souhaitez-vous prendre rendez-vous ?

    - if @motifs.empty?
      / TODO: mettre un formulaire de motif
    - else
      ul.fr-raw-list
        - @motifs.each do |motif|
          li.fr-card.fr-enlarge-link.fr-enlarge-link.fr-mb-2w
            .fr-card__body
              .fr-card__content
                .fr-card__title
                  = link_to motif.name, "#"
                .fr-card__end
                  .fr-card__detail
                    = location_type_icon(motif.location_type, class: "fr-mr-1w")
                    = motif.human_attribute_value(:location_type)
                    = " · "
                    = "#{motif.default_duration_in_min} mn"

    - if @rdv_plan.return_url
      = link_to @rdv_plan.return_url do
        = back_icon(class: "fr-mr-1w")
        = "Retour sur #{@rdv_plan.oauth_application.name}"
