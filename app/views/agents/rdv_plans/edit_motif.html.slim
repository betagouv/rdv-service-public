.fr-grid-row.fr-mb-16w
  .fr-col-12
    = render "agents/rdv_plans/header", rdv_plan: @rdv_plan, current_step: 1, step_title: "Motif", next_step_title: "Créneau"

  .fr-col-12.fr-col-md-8
    - if @motifs.empty?
      = render "agents/rdv_plans/motifs/new", rdv_plan: @rdv_plan
    - else
      p Pour quel motif souhaitez-vous prendre rendez-vous ?
      ul.fr-raw-list
      - @motifs.each do |motif|
        li.card.d-flex.fr-enlarge-link
          .card-body
            = link_to update_motif_agents_rdv_plan_path(@rdv_plan, rdv_plan: { motif_id: motif.id}), method: :patch do
              .fr-h6.rdv-color-text-action-high-blue-france = motif.name
            .d-flex.rdv-justify-content-space-between.rdv-align-items-baseline
              p.fr-mb-0
                = location_type_icon(motif.location_type, class: "fr-mr-1w")
                = motif.human_attribute_value(:location_type)
                = " · "
                = "#{motif.default_duration_in_min} min."
              = icon("fr-icon-arrow-right-line", class: "rdv-color-text-action-high-blue-france")

    - if @rdv_plan.return_url
      = link_to "Retour sur #{@rdv_plan.oauth_application.name}", @rdv_plan.return_url, class: "fr-btn fr-btn--tertiary fr-btn--icon-left fr-icon-arrow-left-line"
