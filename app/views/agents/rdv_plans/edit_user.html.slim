= render "agents/rdv_plans/header", rdv_plan: @rdv_plan, current_step: 3, step_title: "Usager", next_step_title: ""

.fr-grid-row
  .fr-col-12[class=(@rdv_plan.oauth_application.present? ? "fr-mb-16w" : "fr-col-md-10 fr-col-offset-md-1 card card-body" ) ]
    div
      = render "agents/rdv_plans/summary/motif", rdv_plan: @rdv_plan
      = render "agents/rdv_plans/summary/agent", rdv_plan: @rdv_plan
      = render "agents/rdv_plans/summary/starts_at", rdv_plan: @rdv_plan
      = render "agents/rdv_plans/summary/location_type", rdv_plan: @rdv_plan

    hr.fr-mt-2w
    - if @rdv_plan.user
      = render "edit_user_form"
    - else
      = label_tag :user_id, "Qui souhaitez-vous inviter ?"

      .d-flex
        .flex-grow-1.fr-pr-2w
          .js-rdv-invitation-user-picker
            = select_tag :user_id,
              options_for_select([]),
              required: true,
              class: "select2-input js-rdv-invitation-user-picker__select",
              data: { \
                "redirect-url": edit_user_agents_rdv_plan_url(@rdv_plan, host: current_domain.host_name),
                "select2-config": { ajax: { url: search_agents_users_path(organisation_id: @rdv_plan.organisation.id), dataType: "json", delay: 250}, placeholder: "Chercher un usager par nom, prénom, téléphone, ou email" }, }
            = form_with url: update_user_agents_rdv_plan_path(@rdv_plan), method: :patch, html: { class: "js-rdv-invitation-user-picker__form"} do |f|
              = f.hidden_field :user_id

        div
          span.fr-text-mention--grey.fr-text--sm
            | Vous ne trouvez pas l'usager ?&nbsp;

          button[data-fr-opened="#{@user.present?}" aria-controls="new-user-modal" type="button" class="fr-btn fr-btn--sm fr-btn--tertiary-no-outline"]
            | Ajouter un usager

- if @rdv_plan.user.blank?
  dialog#new-user-modal.fr-modal[aria-labelledby="new-user-modal-title"]
    .fr-container.fr-container--fluid.fr-container-md
      .fr-grid-row.fr-grid-row--center
        .fr-col-12.fr-col-md-8
          .fr-modal__body
            .fr-modal__header
              button[aria-controls="new-user-modal" title="Fermer" type="button" class="fr-btn--close fr-btn"] Fermer
            .fr-modal__content.fr-mb-4w
              h2.fr-modal__title#new-user-modal-title
                = user_icon(class: "fr-mr-1w")
                | Nouvel usager
              - user = @user || User.new
              = form_for user, url: create_user_agents_rdv_plan_path(@rdv_plan), method: :post, builder: Dsfr::FormBuilder do |f|
                .fr-grid-row.fr-grid-row--gutters
                  .fr-col-6
                    = f.dsfr_text_field :first_name, required: true
                  .fr-col-6
                    = f.dsfr_text_field :last_name, required: true
                  .fr-col-6
                    = f.dsfr_email_field :email, required: true, autocomplete: "off"
                  .fr-col-6
                    = f.dsfr_phone_field :phone_number, as: :tel, required: @rdv_plan.motif.phone?
                .fr-btns-group.fr-btns-group--right.fr-mt-4w
                  = f.submit "Enregistrer", class: "fr-btn"
