.row.justify-content-md-center
  .col-12
    = render "agents/rdv_plans/header", rdv_plan: @rdv_plan, current_step: 2, step_title: "Modalités", next_step_title: "Usager"
    .card
      .card-body
        = simple_form_for @rdv_plan, url: create_from_modalites_agents_rdv_plans_path do |f|
          = f.hidden_field :user_id, value: params[:user_id]

          .row
            .col-6
              = datetime_input(f, :starts_at)
            .col-6
              = f.input :duration_in_minutes, label: "Durée en minutes"
          .row.fr-mt-2w
            .col-12
              | Comment souhaitez-vous faire le rendez-vous ?

              = f.collection_radio_buttons :modalite, ([["phone", sanitize(" #{icon("fr-icon-mac-fill")} Par téléphone")], ["visio", 'Par visioconférence']] + Lieu.enabled.where(organisation_id: current_agent.organisations.select(:id)).map do |l| ["onsite-#{l.id}", "à #{ l.name }"] end), :first, :last, item_wrapper_tag: :div

          = f.submit "Continuer", class: "fr-btn float-right"
        = link_to "retour", calendar_agents_rdv_plans_path(user_id: params[:user_id])
