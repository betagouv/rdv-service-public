.row.justify-content-md-center.fr-mb-4w
  .col-12
    = render "agents/rdv_plans/header", rdv_plan: @rdv_plan, current_step: 1, step_title: "Créneau", next_step_title: "Motif"
    .row
      .col-4
        ruby:
          current_organisation = current_agent.organisations.first
          event_sources = [
            admin_api_agenda_rdvs_path(agent_id: current_agent, organisation_id: current_organisation.id, format: :json),
            admin_api_agenda_absences_path(agent_id: current_agent, organisation_id: current_organisation.id, format: :json),
            admin_api_agenda_plage_ouvertures_path(agent_id: current_agent, organisation_id: current_organisation.id, in_background: true, format: :json),
            OffDays.to_full_calendar_array,
            [{
              title: @rdv_plan.user.full_name,
              start: @rdv_plan.starts_at.as_json,
              end: (@rdv_plan.starts_at + 30.minutes).as_json,
              textColor: "white",
              backgroundColor: "#6a6af4"
            }]
          ]

        #rdvPlanCalendar.fr-mb-4w[
          data-default-date-json="#{Date.parse(params[:starts_at]).to_date.to_json}"
          data-user-id="#{params[:user_id]}"
          data-selected-event-id="#{@selected_event_id}"
          data-organisation-id="#{current_agent.organisations.first.id}"
          data-display-saturdays="#{current_agent.display_saturdays}"
          data-display-sundays="false"
          data-event-sources-json="#{event_sources.to_json}"
          data-sign-in-path="#{new_agent_session_path}"
          data-min-time="#{I18n.l(@rdv_plan.starts_at - 2.hours, format: "%H:%M:%S")}"
          data-max-time="#{I18n.l(@rdv_plan.starts_at + 3.hours, format: "%H:%M:%S")}"
          data-single-day="true"
          style="margin-top: -40px"
        ]

        = link_to new_from_calendar_agents_rdv_plans_path(user_id: params[:user_id]) do
          = back_icon(class: "fr-mr-1w")
          = "retour"
      .col-8
        = simple_form_for @rdv_plan, url: create_from_modalites_agents_rdv_plans_path do |f|
          = f.hidden_field :user_id, value: params[:user_id]

          .fr-mb-4w
            .input-group
              = datetime_input(f, :starts_at, options: { label_html: { style: "flex-shrink: 0;", class: "fr-mr-2w" }, wrapper_html: { class: "d-flex", style: "align-items: baseline;" }})
            .input-group
              = f.input :duration_in_minutes, label: "Durée en minutes", label_html: { style: "flex-shrink: 0;", class: "fr-mr-2w" }, wrapper_html: { class: "d-flex", style: "align-items: baseline;" }

          = "Comment souhaitez-vous faire le rendez-vous ?"
          = f.collection_radio_buttons :modalite, modalites_collection, :first, :last, item_wrapper_tag: :div, item_wrapper_class: "fr-m-2w"

          = f.submit "Continuer", class: "fr-btn float-right"
