.fr-grid-row.fr-mb-16w
  .fr-col-12[class=(@rdv_plan.oauth_application.present? ? "fr-mb-16w" : "fr-col-md-8  fr-col-offset-md-2 card card-body fr-mt-4w" )]
    .fr-grid-row.justify-content-center.fr-mb-2w
      = dsfr_svg "artwork/pictograms/digital/mail-send", class: "fr-artwork--green-emeraude"
    p Un email a été envoyé à <b>#{@rdv_plan.user.full_name}</b> à l'adresse #{@rdv_plan.user.email} pour l'inviter à prendre rendez-vous pour le motif <b>#{@rdv_plan.motif.name}</b>.

    p Vous pouvez retrouver cette invitation sur la page du profil de cet usager.

    .fr-grid-row.rdv-justify-content-space-between.rdv-align-items-baseline
      = button_to "Annuler l'invitation", cancel_admin_organisation_rdv_invitation_path(current_organisation, @rdv_plan.rdv_invitation), class: "fr-btn fr-btn--secondary", method: :patch
      - if @rdv_plan.return_url
        = link_to "Retour sur #{@rdv_plan.oauth_application.name}", @rdv_plan.return_url, class: "float-right fr-btn"
      - if @rdv_plan.oauth_application.blank?
        = link_to "Retour au planning", admin_organisation_planning_agenda_path(current_organisation), class: "fr-btn fr-btn--secondary fr-btn--icon-right fr-icon-arrow-right-line"
