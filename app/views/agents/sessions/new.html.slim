h1.rdv-text-align-center.text-dark.mt-0.font-weight-bold.mb-4 Connexion à #{current_domain.name}

- if display_agent_connect_button?
  = render "common/proconnect_button"

  .row.p-2
    .alert.alert-info.d-flex
      .mr-3
        i.fa.fa-info
      span
        - if display_inclusion_connect_button?
          = "Privilégiez maintenant ProConnect qui remplace Agent Connect et Inclusion Connect. "
          br
          | Si nécessaire, #{link_to("cliquez ici", inclusion_connect_auth_path)} pour continuer d'utiliser Inclusion Connect.

        - else
          = "Vous pouvez dès maintenant utiliser ProConnect à la place d’Agent Connect. "
  .row.pt-2.pb-2
    .col
      hr
    .col-auto.p-0.pt-1
      .text-uppercase ou
    .col
      hr

p.text-muted.mb-2 Entrez votre email et votre mot de passe.
= form_for resource, as: resource_name, url: session_path(resource_name) do |f|
  = render "devise/shared/error_messages", resource: resource
  .form-group
    = f.label :email
    = f.email_field :email, autofocus: true, class: "form-control", placeholder: "nom.prenom@email.com"
  .form-group
    = f.label :password
    = f.password_field :password, autocomplete: "current-password", required: true, class: "form-control ", placeholder: "Votre mot de passe", id: "password"
    span.fa.fa-fw.fa-eye.toggle-password role="button" aria-hidden="true" tabindex="-1"

    .mt-1.mb-3= link_to "Mot de passe oublié ?", new_password_path(resource_name)

  .form-group.mb-0.rdv-text-align-center
    = f.submit "Se connecter", class: "btn btn-primary"
