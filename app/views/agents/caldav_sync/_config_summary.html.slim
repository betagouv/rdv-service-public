.card
  .card-body

    .fr-grid-row.fr-grid-row--gutters
      .fr-col-4 Statut
      .fr-col-8
        - if config.disconnect_in_progress?
          .fr-badge.fr-badge--warning Synchronisation en cours de suppression
        - elsif config.broken?
          .fr-badge.fr-badge--error Synchronisation interrompue
        - else
          .fr-badge.fr-badge--success Synchronisation active

        - if config.disconnect_in_progress?
          .fr-hint-text.fr-mt-1w
            |> Les événements qui avaient été importés dans votre agenda sont en cours de suppression. Cela peut prendre quelques minutes.
            | Vous pouvez revenir sur cette page plus tard pour reconfigurer vos identifiants CalDAV.
          .fr-mt-1v
            = link_to("Recharger la page", url_for)
        - else
          - ended_at = config.latest_successful_execution.ended_at
          .fr-hint-text.fr-mt-1w
            | Dernière synchro
            strong< il y a #{time_ago_in_words(ended_at)}
            |< (#{I18n.l(ended_at, format: :short)}).
          .fr-mt-1v
            = link_to("Consulter l'historique de synchronisation", agents_calendar_sync_logs_path)

    .fr-grid-row.fr-grid-row--gutters.fr-mt-2w
      .fr-col-4 Nom d'utilisateur
      .fr-col-8 = config.caldav_username

    - if config.caldav_calendar_name.present?
      .fr-grid-row.fr-grid-row--gutters.fr-mt-2w
        .fr-col-4 Nom d’affichage
        .fr-col-8 = config.caldav_calendar_name

    - if config.caldav_calendar_color.present?
      .fr-grid-row.fr-grid-row--gutters.fr-mt-2w
        .fr-col-4 Couleur d’affichage
        .fr-col-8
          span.fr-icon-circle-fill[style="color: #{config.caldav_calendar_color}" aria-hidden="true"]

    .fr-grid-row.fr-grid-row--gutters.fr-mt-2w
      .fr-col-4 Données personnelles
      .fr-col-8
        - if config.caldav_include_sensitive_data
          | Transmises au calendrier externe
        - else
          | Anonymisées

    .fr-grid-row.fr-grid-row--gutters.fr-mt-2w
      .fr-col-4 URL de l'agenda
      .fr-col-8
        pre = config.caldav_agenda_url

  - unless config.disconnect_in_progress?
    .fr-btns-group.fr-btns-group--inline.fr-ml-2w
      - if current_agent.organisations.any?
        = link_to("Voir mon agenda", admin_organisation_planning_agenda_path(current_agent.organisations.first), class: "fr-btn fr-btn--secondary")
      = form_tag agents_calendar_sync_caldav_sync_path, method: :delete do
        = submit_tag "Supprimer la configuration CalDAV", class: "fr-btn fr-btn--tertiary", data: { confirm: "Êtes-vous sûr de vouloir supprimer vos identifiants CalDAV ?" }
