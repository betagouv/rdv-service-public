- content_for :title, "Historique des synchronisations"

- content_for :breadcrumbs do
  = dsfr_breadcrumbs do |b|
    = b.with_breadcrumb label: "Synchronisation d'agenda", href: agents_calendar_sync_path
    = b.with_breadcrumb label: "Configuration de la synchronisation CalDAV", href: agents_calendar_sync_caldav_sync_path
    = b.with_breadcrumb label: "Historique des synchronisations"

.fr-table.fr-table--no-scroll.fr-mx-2w
  .fr-table__wrapper
    .fr-table__container
      .fr-table__content
        table
          thead
            tr
              th Date
              th État
              th Durée
              th Logs
          tbody
            - @sync_logs.each do |log|
              tr id="external_calendar_sync_log_#{log.id}"
                td = I18n.l(log.started_at, format: :human)
                td = log.status
                td = "#{log.duration.in_milliseconds.to_i} ms" if log.ended_at?
                td
                  ol
                    - log.text_logs.each do |log_line|
                      li = log_line
  .fr-table__footer
    .fr-table__footer--middle
      = paginate @sync_logs, theme: "dsfr"
