- content_for :title, t(".title")

= form_for @agent, url: agents_preferences_path, builder: Dsfr::FormBuilder do |f|
  = render "devise/shared/error_messages", resource: @agent

  ruby:
    rdv_notifications_levels = Agent.rdv_notifications_levels.each_key.map do |value|
        {
            value:,
            label: Agent.human_attribute_value(:rdv_notifications_level, value),
            checked: @agent.rdv_notifications_level == value,
        }
    end

  = f.dsfr_radio_buttons :rdv_notifications_level, rdv_notifications_levels, legend: t(".rdv_notifications_header")

  hr

  ruby:
    plage_ouverture_notification_levels = Agent.plage_ouverture_notification_levels.each_key.map do |value|
        {
            value:,
            label: Agent.human_attribute_value(:plage_ouverture_notification_level, value),
            checked: @agent.plage_ouverture_notification_level == value,
        }
    end

  = f.dsfr_radio_buttons :plage_ouverture_notification_level, plage_ouverture_notification_levels, legend: t(".plage_ouverture_notifications_header")

  hr

  ruby:
    absence_notification_levels = Agent.absence_notification_levels.each_key.map do |value|
        {
            value:,
            label: Agent.human_attribute_value(:absence_notification_level, value),
            checked: @agent.absence_notification_level == value,
        }
    end

  = f.dsfr_radio_buttons :absence_notification_level, absence_notification_levels, legend: t(".absence_notifications_header")

  hr

  .fr-alert.fr-alert--info.fr-mb-2w
    = t(".technical_email_explanation")

  .text-right= f.submit t("helpers.submit.submit"), class: "fr-btn"
