- motif_selection_service = CreneauWizardForUsers::Steps::MotifSelection.new(context)

- if motif_selection_service.unique_motifs_by_name_and_location_type.empty?
  = render "search/nothing_to_show", context: context
- elsif motif_selection_service.service_selected?
  - content_for :title, "Sélectionnez le motif"
  p.fr-text--lg Sélectionnez le motif de votre RDV&nbsp;:
  ul.fr-raw-list
    - motif_selection_service.unique_motifs_by_name_and_location_type.each do |motif|
      = render "search/motif_card", context: context, motif: motif
- else
  = render "search/service_selection", context:, motif_selection_service:

= render "search/referent_booking_card", context:, motif_selection_service:
