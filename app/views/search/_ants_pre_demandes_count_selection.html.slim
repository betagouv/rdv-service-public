= render "search/selected_motif_recap", context: context

.fr-card
  .fr-card__body
    .fr-card__content
      h3 Nombre de pré-demandes ANTS
      p
        |> Chaque personne souhaitant une nouvelle carte d'identité ou passeport doit avoir rempli une pré-demande en ligne sur le site de l’ANTS.
        = link_to "Faites votre pré-demande ici", "https://passeport.ants.gouv.fr/demarches-en-ligne", target: "_blank"
      = form_with url: prendre_rdv_path, method: :get, builder: Dsfr::FormBuilder do |f|
        - context.query_params.each do |key, value|
          = hidden_field_tag key, value

        = f.label :ants_pre_demandes_count do
          | Indiquez ci-dessous le nombre total de pré-demandes ANTS à traiter :
        .fr-grid-row
          .fr-col-12.fr-col-sm-6.fr-col-md-5.fr-col-lg-3
            .d-flex.rdv-gap-1rem.fr-mb-2w[data-controller="counter-field"]
              button.fr-btn.fr-btn--secondary[type="button" data-action="click->counter-field#decrement"]
                | -
              = f.text_field :ants_pre_demandes_count,
                class: "fr-input rdv-text-align-center",
                value: context.query_params[:ants_pre_demandes_count] || 1,
                data: { counter_field_target: "input", min: 1, max: 6 }
              button.fr-btn.fr-btn--secondary[type="button" data-action="click->counter-field#increment"]
                | +
            ul.fr-btns-group.fr-btns-group--inline.fr-my-1w
              li
                = f.submit "Valider", class: "fr-btn"
