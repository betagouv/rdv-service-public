= render "search/selected_motif_recap", context: context

/ On n’utilise pas un form object classique ici mais une validation et un affichage des erreurs custom
/ L’aspect particulier du champ texte entouré des deux boutons + et - cause des soucis avec le layout
/ par défaut des formulaires DSFR en erreur.
- invalid_count = context.query_params.key?(:ants_pre_demandes_count) && !AntsPreDemandesCountValidator.count_valid?(context.query_params[:ants_pre_demandes_count])

.fr-card
  .fr-card__body
    .fr-card__content
      h3 Nombre de pré-demandes ANTS
      p
        |> Chaque personne souhaitant une nouvelle carte d'identité ou passeport doit avoir rempli une pré-demande en ligne sur le site de France Titres - Agence Nationale des Titres Sécurisés (ANTS).
        = link_to "Faites votre pré-demande ici", "https://passeport.ants.gouv.fr/demarches-en-ligne", target: "_blank"
      = form_with url: prendre_rdv_path, method: :get, builder: Dsfr::FormBuilder do |f|
        - context.query_params.each do |key, value|
          = hidden_field_tag key, value
        .fr-input-group class=(invalid_count && "fr-input-group--error")
          = f.label :ants_pre_demandes_count do
            | Indiquez ci-dessous le nombre total de pré-demandes ANTS à traiter (maximum #{AntsPreDemandesCountValidator::MAX}) :
          - if invalid_count
              p.fr-error-text= AntsPreDemandesCountValidator::ERROR_MESSAGE
        .fr-grid-row
          .fr-col-12.fr-col-sm-6.fr-col-md-5.fr-col-lg-3
            .d-flex.rdv-gap-1rem.fr-mb-2w[data-controller="counter-field"]
              button.fr-btn.fr-btn--secondary[type="button" data-action="click->counter-field#decrement"]
                | -
              = f.text_field :ants_pre_demandes_count,
                inputmode: "number",
                class: "fr-input rdv-text-align-center",
                value: context.query_params.fetch(:ants_pre_demandes_count, 1),
                data: { counter_field_target: "input",
                  min: AntsPreDemandesCountValidator::MIN,
                  max: AntsPreDemandesCountValidator::MAX, }
              button.fr-btn.fr-btn--secondary[type="button" data-action="click->counter-field#increment"]
                | +
        ul.fr-btns-group.fr-btns-group--inline.fr-my-1w
          li
            = f.submit "Valider", class: "fr-btn"
