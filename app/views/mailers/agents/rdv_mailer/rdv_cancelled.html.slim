div
  p= t("mailers.common.hello")
  p
    - date = relative_date(@rdv.starts_at)
    - author = @author.full_name
    - if @rdv.status == "revoked"
      | Un RDV qui devait avoir lieu #{date} vient d’être annulé par #{author} pour raison administrative.
    - elsif @author.is_a? Agent
      | Un RDV qui devait avoir lieu #{date} vient d’être annulé par #{author} à la demande de l’usager.
    - elsif @author.is_a?(User) && @rdv.collectif?
      | La participation au RDV collectif #{date} vient d’être annulé par l’usager #{author}.
    - else
      | Un RDV qui devait avoir lieu #{date} vient d’être annulé par l’usager #{author}.

    = render "mailers/common/rdv_overview", rdv: @rdv, for_role: :agent

  p.aligncenter
    = link_to "Voir sur #{domain.name}", admin_organisation_rdv_url(@rdv.organisation_id, @rdv.id),  class: "btn btn-primary"

  br
  = t("mailers.common.farewell_html", domain_name: domain.name)
