json = {}

([:id] + RdvBlueprint::FIELDS).each do |field_name|
  json[field_name] = rdv.public_send(field_name)
end

created_by_type_map = {
  "Agent" => "agent",
  "User" => "user",
  "Prescripteur" => "prescripteur",
  "FileAttente" => "file_attente",
}

json[:created_by] = created_by_type_map[rdv.created_by_type]

json[:url_for_agent] = Rails.application.routes.url_helpers.agents_rdv_url(rdv, host: rdv.domain.host_name)

if params[:include].blank? || params[:include].values.include?("organisation")
  json[:organisation] = OrganisationBlueprint.render_as_hash(rdv.organisation)
end

if params[:include].blank? || params[:include].values.include?("motif")
  json[:motif] = MotifBlueprint.render_as_hash(rdv.motif)
end

if params[:include].blank? || params[:include].values.include?("participations")
  json[:participations] = ParticipationBlueprint.render_as_hash(rdv.participations)
end

if params[:include].blank? || params[:include].values.include?("agents")
  json[:agents] = AgentBlueprint.render_as_hash(rdv.agents)
end

if params[:include].blank? || params[:include].values.include?("lieu")
  json[:lieu] = LieuBlueprint.render_as_hash(rdv.lieu)
end

# DEPRECATED : Nous laissons l'association `:users` le temps que le 92, 26, 62, 64, et data-insertion mettent à jours leur système.
if params[:include].blank?
  json[:users] = UserBlueprint.render_as_hash(rdv.users)
end

json
