.dropdown.text-right id="rdv-status-#{rdv.id}"
  = collective_rdv_status_dropdown_toggle(rdv)
  - remote = true
  .dropdown-menu
    - case rdv.temporal_status
      - when "unknown_future"
        = render "admin/rdvs/collective_rdv_status_dropdown_item", rdv: rdv, agent: agent, status: "revoked"

      - when "unknown_today", "unknown_past"
        = render "admin/rdvs/collective_rdv_status_dropdown_item", rdv: rdv, agent: agent, status: "seen"
        .dropdown-divider
        = render "admin/rdvs/collective_rdv_status_dropdown_item", rdv: rdv, agent: agent, status: "revoked"

      - else
        = render "admin/rdvs/collective_rdv_status_dropdown_item", rdv: rdv, agent: agent, status: "unknown"

    - if policy(rdv, policy_class: Agent::RdvPolicy).destroy?
      .dropdown-divider
      = rdv_status_delete_dropdown_item(rdv, agent)
