.dropdown id="rdv-status-#{rdv.id}"
  = individual_rdv_status_dropdown_toggle(rdv)
  .dropdown-menu
    - if rdv.status == "unknown"
      - if rdv.starts_at < Time.zone.now
        = render "admin/rdvs/individual_rdv_status_dropdown_item", rdv: rdv, status: "seen",  quick_update: local_assigns[:quick_update]
        = render "admin/rdvs/individual_rdv_status_dropdown_item", rdv: rdv, status: "noshow",  quick_update: local_assigns[:quick_update]
        .dropdown-divider

      = render "admin/rdvs/individual_rdv_status_dropdown_item", rdv: rdv, status: "excused",  quick_update: local_assigns[:quick_update]
      = render "admin/rdvs/individual_rdv_status_dropdown_item", rdv: rdv, status: "revoked",  quick_update: local_assigns[:quick_update]

    - else
      = render "admin/rdvs/individual_rdv_status_dropdown_item", rdv: rdv, status: "unknown",  quick_update: local_assigns[:quick_update]

    - if policy(rdv, policy_class: Agent::RdvPolicy).destroy?
      .dropdown-divider
      = rdv_status_delete_dropdown_item(rdv)
