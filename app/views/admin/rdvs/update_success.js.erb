<%# locals: (rdv:, agent:, success_message:) %>

<% template = params[:quick_update].to_bool ? "admin/rdvs/rdv_with_quick_update" : "admin/rdvs/rdv" %>
<% rdv_html = render template, rdv: rdv, locals: { agent: agent }, success_message: success_message %>
(function() {
  let element = document.getElementById('rdv-<%= rdv.id %>');
  if(element) {
    element.outerHTML = "<%= escape_javascript rdv_html %>";
  }
})();
