.fr-grid-row.fr-mt-2w
  .fr-col-8.fr-col-offset-2
    = render "agents/rdv_plans/header", rdv_plan: @rdv_plan, current_step: 3, step_title: "Usager", next_step_title: ""

    .card.card-body.fr-p-2w[style="margin-top: -24px"]
      .fr-col-12
        = render "agents/rdv_plans/summary/motif", rdv_plan: @rdv_plan
        = render "agents/rdv_plans/summary/agent", rdv_plan: @rdv_plan
        = render "agents/rdv_plans/summary/starts_at", rdv_plan: @rdv_plan
        = render "agents/rdv_plans/summary/location_type", rdv_plan: @rdv_plan

      hr.fr-mt-2w
      h2.fr-h5 Coordonnées de #{@rdv_plan.user.full_name}
      = form_for @rdv_plan, url: create_rdv_admin_organisation_rdv_plan_path(current_organisation, @rdv_plan), method: :post, builder: Dsfr::FormBuilder do |f|
        = f.fields_for :user, @rdv_plan.user do |ff|
          .fr-grid-row.fr-grid-row--gutters
            .fr-col-6
              = ff.dsfr_email_field :email, autocomplete: "off", hint: ("Cet usager utilise cette adresse email pour se connecter." if @rdv_plan.user.already_logged_in?), required: @rdv_plan.by_invitation?
            .fr-col-6
              = ff.dsfr_phone_field :phone_number, as: :tel, required: @rdv_plan.motif.phone?
        - if @rdv_plan.motif.visible_and_notified?
          .fr-grid-row.fr-grid-row--gutters
            .fr-col-12
              = f.fields_for :participation, (Participation.new(send_lifecycle_notifications: true, send_reminder_notification: true)) do |ff|
                = ff.dsfr_check_box :send_lifecycle_notifications, label: "Envoyer une notification de confirmation"
                = ff.dsfr_check_box :send_reminder_notification, label: "Envoyer une notification de rappel 48h avant le rendez-vous"
        - else
          | Les notifications ne sont pas envoyées pour ce motif de rendez-vous.

        - submit_text = @rdv_plan.by_invitation? ? "Envoyer l'invitation" : "Confirmer le rendez-vous"
        = f.submit submit_text, class: "fr-btn float-right"

        - if @rdv_plan.by_invitation?
          = link_to "Retour", edit_rdv_invitation_admin_organisation_rdv_plan_path(current_organisation, @rdv_plan), dsfr_return_btn_options
        - else
          - return_path =  @rdv_plan.motif.requires_lieu? ? edit_lieu_admin_organisation_rdv_plan_path(current_organisation, @rdv_plan) : edit_starts_at_admin_organisation_rdv_plan_path(current_organisation, @rdv_plan)
          = link_to "Retour", return_path, dsfr_return_btn_options
