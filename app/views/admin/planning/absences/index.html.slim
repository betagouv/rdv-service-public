- content_for(:menu_item) { "menu-absences" }

- content_for :title do
  - if current_agent == @agent
    = t(".your_absences")
  - else
    = t(".absences_of", full_name: @agents.map(&:full_name_and_service).join(", "))

= render partial: "admin/planning/planning_tabs"

- if @agents.size == 1
  - content_for :breadcrumb do
    = link_to t(".create_absence"), new_admin_organisation_planning_absence_path(current_organisation, agent_id: @agent.id), class: "btn btn-outline-primary align-bottom"

  .card.pb-3
    - if @display_tabs
      ul.nav.nav-tabs.px-2.mt-2
        li.nav-item
          = active_link_to "En cours", admin_organisation_planning_absences_path(current_organisation, { agent_id: params[:agent_id] }.compact_blank), class: "nav-link", active: :exact
        li.nav-item
          = active_link_to "Passées", admin_organisation_planning_absences_path(current_organisation, { agent_id: params[:agent_id] }.compact_blank, current_tab: "expired"), class: "nav-link", active: :exact

    - if @absences.any?
      .fr-table.fr-mx-2w
        .fr-table__wrapper
          .fr-table__container
            .fr-table__content
              table
                thead
                  tr
                    th Description
                    th Dates
                    th Actions
                tbody
                  = render @absences
        .fr-table__footer
          .fr-table__footer--middle
            = paginate @absences, theme: "dsfr"

    - else
      .row.justify-content-md-center.p-2.mt-3
        .col-md-6.rdv-text-align-center.mb-2
          p.mb-2.lead
            - if current_agent == @agent
              = t(".you_not_yet_create_absence")
            - else
              = t(".has_no_absence_yet", full_name: @agent.full_name_or_email)
          p = t(".explanation_html")
          span.fa-stack.fa-4x
            i.fa.fa-circle.fa-stack-2x.text-primary
            i.far.fa-calendar.fa-stack-1x.text-white
    .rdv-text-align-center.py-2
      = link_to new_admin_organisation_planning_absence_path(current_organisation, agent_id: @agent.id), class: "fr-btn" do
        - if @agent == current_agent
          = t(".create_absence")
        - else
          = t(".create_absence_for", full_name: @agent.full_name_or_email)

  - unless current_territory.visioplainte?
    = dsfr_alert type: :info, size: :sm, html_attributes: { class: "fr-mb-2v" } do
      |< Les jours fériés sont automatiquement considérés comme indisponibles.
- else
  - @agents.each do |agent|
    .fr-tile.fr-tile--sm.fr-tile--horizontal.fr-enlarge-link.mt-2
      .fr-tile__body
        .fr-tile__content
          h3.fr-tile__title
            a[href=admin_organisation_planning_absences_path(current_organisation, { agent_id: agent.id }.compact_blank)]
              = agent.full_name
          p.fr-tile__detail
            | #{agent.absences.size} indisponibilités
      .fr-tile__header
        .fr-tile__pictogram
          = dsfr_svg "artwork/pictograms/digital/avatar", class: "fr-responsive-img"
