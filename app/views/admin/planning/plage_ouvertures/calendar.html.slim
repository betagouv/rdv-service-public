- content_for(:menu_item) { "menu-plages-ouvertures" }
- content_for(:menu_agent_select_path_helper_name) { "admin_organisation_planning_plage_ouvertures_path" }

- content_for :title do
  - if current_agent == @agent
    | Plages d’ouverture
  - else
    | Plages d’ouverture de #{@agent.full_name_and_service}

- content_for :fil_ariane do
  = render "common/fil_ariane", titles_and_paths: [["Accueil", root_path]], current_page_title: yield(:title)

- content_for :breadcrumb do
  .fr-btns-group.fr-btns-group--inline.fr-btns-group--icon-left
    = link_to t("admin.planning.plage_ouvertures.index.list_view"), admin_organisation_planning_plage_ouvertures_path(current_organisation, agent_id: @agent.id, search: params[:search], current_tab: params[:current_tab]), class: "fr-btn fr-btn--secondary fr-icon-list-unordered"
    = link_to t("admin.planning.plage_ouvertures.index.create_plage_ouverture"),  new_admin_organisation_planning_plage_ouverture_path(current_organisation, agent_id: @agent.id), class: "fr-btn fr-btn--secondary"

ruby:
  event_sources = [admin_api_agenda_plage_ouvertures_path(agent_id: @agent, organisation_id: current_organisation.id)]
  event_sources.push(OffDays.to_full_calendar_array) unless current_territory.work_on_sunday?

  full_calendar_config_from_server = {
    hiddenDays: fc_hidden_days_for(current_agent, current_territory),
    eventSources: event_sources
  }

#calendar [
  data-full-calendar-config-from-server-json=full_calendar_config_from_server.to_json
  data-agent-id="#{@agent.id}"
  data-organisation-id="#{@current_organisation.id}"
]
