- content_for(:menu_item) { "menu-plages-ouvertures" }

- content_for :title, "Plages d'ouverture (#{my_agents.count} #{'agent'.pluralize(my_agents.count)} sélectionnés)"

- my_agents.includes(:services).each do |agent|
  .fr-tile.fr-tile--sm.fr-tile--horizontal.fr-enlarge-link.mt-2
    .fr-tile__body
      .fr-tile__content
        h3.fr-tile__title
          a[href=admin_organisation_planning_plage_ouvertures_path(current_organisation, { agent_id: agent.id }.compact_blank)]
            = agent.full_name_or_email
        p.fr-tile__desc
          = agent.services.map(&:short_name).join(", ")
        p.fr-tile__detail
          | #{pluralize(agent.plage_ouvertures.size, "plage", plural: "plages")} d'ouverture
    .fr-tile__header
      .fr-tile__pictogram
        = dsfr_svg "artwork/pictograms/digital/avatar", class: "fr-responsive-img"
