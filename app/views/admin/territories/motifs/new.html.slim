- content_for :title, t("motifs.form.title.new")

= territory_navigation(content_for(:title), [["Liste des motifs", admin_territory_motifs_path(current_territory)]])

.row
  .col-md-12
    = form_for @motif, url: admin_territory_motifs_path, builder: Dsfr::FormBuilder, html: { "data-controller": "motif-form" } do |f|
      = render "model_errors", model: @motif, f: f
      = render "admin/motifs/form/organisations_picker", motif: @motif, f: f
      = render "admin/motifs/form", motif: @motif, f: f, rdvi_mode: @organisations.any?(&:rdv_insertion?)
