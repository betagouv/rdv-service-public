= territory_navigation("Organisations")

.fr-grid-row
  .fr-col-md-10
    h1 Fermer une organisation

    .card
      .card-body
        p Quelle organisation souhaitez-vous fermer ?

        = form_with url: close_admin_territory_organisations_path(current_territory), method: :patch, builder: Dsfr::FormBuilder do |f|
          = f.select :organisation_id, @organisations.map { |o| [o.name, o.id] }, {}, { class: "select2-input", data: { "select2-config": { disableSearch: true, width: "50%" } } }
          = f.submit "Fermer cette organisation", class: "fr-btn fr-mt-2w"
