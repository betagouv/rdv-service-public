= territory_navigation(t(".webhook_title"))

.row.justify-content-center
  .col-md-10
    .card
      .card-body
        - if @webhooks.any?
          table.table
            thead
              tr
                th = t("activerecord.attributes.webhook_endpoint.target_url")
                th = t("activerecord.attributes.webhook_endpoint.organisation_ids")
                th = t("activerecord.attributes.webhook_endpoint.subscriptions")
                th Actions
            tbody
              - @webhooks.each do |webhook|
                tr
                  td = webhook.target_url
                  td
                    ul
                      - webhook.organisations.order(:name).each do |organisation|
                        li = organisation.name
                  td
                    ul
                      - webhook.subscriptions.each do |subscription|
                        li = subscription.classify.constantize.model_name.human
                  td
                    .d-flex
                      div.mr-3= link_to edit_admin_territory_webhook_endpoint_path(current_territory, webhook), title: t("helpers.edit") do
                        i.fa.fa-edit
                      = link_to admin_territory_webhook_endpoint_path(current_territory, webhook), title: t("helpers.delete"), method: :delete, data: { confirm: t(".confirm_destroy") } do
                        i.fa.fa-trash-alt

        .d-flex.flex-gap-1em
          = link_to "Ajouter un webhook", new_admin_territory_webhook_endpoint_path(current_territory), class: "btn btn-primary"
          = link_to "Voir la documentation", "https://github.com/betagouv/rdv-service-public/blob/production/docs/api/webhooks/api-notifications-webhooks.md", target: "_blank", class: "btn btn-link"
