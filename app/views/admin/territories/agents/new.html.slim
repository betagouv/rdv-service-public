= territory_navigation(t(".title"), [["Agents", admin_territory_agents_path(current_territory)]])

.card
  .card-body
    - if current_territory.services.any?(&:secretariat?)
      = dsfr_callout do
        | Le service secrétariat a été remplacé par une nouvelle permission « Agent d’accueil » que vous pouvez activer pour chaque agent dans les paramètres de l’organisation.
    = form_for [:admin, @agent], as: :admin_agent, url: admin_territory_agents_path(current_territory), html: { method: :post }, builder: Dsfr::FormBuilder do |f|
      = render "devise/shared/error_messages", resource: @agent
      = f.dsfr_email_field :email, label: "Email", placeholder: t(".email_placeholder"), autocomplete: "off"

      fieldset.fr-fieldset
        legend.fr-fieldset__legend--regular.fr-fieldset__legend
          = Agent.human_attribute_name(:services)
          span.fr-hint-text = t(".services_hint")
        = f.collection_check_boxes :service_ids, @services_to_select, :id, :name, include_hidden: false do |cb|
          .fr-fieldset__element
            .fr-checkbox-group
              = cb.check_box
              = cb.label

      fieldset.fr-fieldset
        legend.fr-fieldset__legend--regular.fr-fieldset__legend
          = t(".organisations")
        = f.collection_check_boxes :organisation_ids, @organisations_to_select, :id, :name, include_hidden: false do |cb|
          .fr-fieldset__element
            .fr-checkbox-group
              = cb.check_box
              = cb.label

      .text-right
        = f.submit t("devise.invitations.new.submit_button"), class: "fr-btn"
