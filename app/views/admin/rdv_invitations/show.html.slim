- content_for :title do
  | Invitation à prendre rendez-vous

.fr-grid-row
  .fr-col-md-10
    .card.card-body
      = dsfr_svg "artwork/pictograms/digital/mail-send", class: "fr-artwork--green-emeraude fr-mb-2w"
      p
        |> Un email a été envoyé à #{@rdv_invitation.user.full_name} pour l'inviter à prendre rendez-vous
        | pour le motif <b>#{@rdv_invitation.motif.name}</b>
        - if @rdv_invitation.lieu_id
          |< à <b>#{@rdv_invitation.lieu.name}</b>
        | .

      p #{@rdv_invitation.user.full_name} n'a pas encore choisi de créneau.

      p.fr-text-mention--grey.fr-text--sm Invitation envoyée par #{@rdv_invitation.inviting_agent.full_name}  #{human_date_format(@rdv_invitation.created_at)}.

      = link_to "Retour au profil de #{@rdv_invitation.user.full_name}", admin_organisation_user_path(current_organisation, @rdv_invitation.user), class: "fr-btn fr-btn--secondary"

