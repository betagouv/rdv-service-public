- content_for :tab_title do
  | Invitation à prendre rendez-vous

.fr-col-12.fr-col-md-10.fr-col-offset-md-1
  h1.fr-h2.fr-pt-2w Invitation à prendre rendez-vous
  = render "common/stepper", step_count: 3, current_step: 3, step_title: "Confirmation"
  .card.card-body.fr-p-2w
    p
      | Nous allons envoyer une invitation à <b>#{@rdv_invitation.user.full_name}</b> à l'adresse <b>#{@rdv_invitation.user.email}</b>
      span
        = icon_link_to "Changer d'usager", edit_user_admin_organisation_rdv_invitation_path(current_organisation, @rdv_invitation), class: "fr-btn fr-btn--tertiary-no-outline fr-btn--sm fr-btn--icon-left fr-icon-edit-line fr-pr-0"
      | pour lui permettre de prendre rendez-vous pour <b>#{@rdv_invitation.motif.name}</b>
      span
        = icon_link_to "Changer de motif", edit_motif_admin_organisation_rdv_invitation_path(current_organisation, @rdv_invitation), class: "fr-btn fr-btn--tertiary-no-outline fr-btn--sm fr-btn--icon-left fr-icon-edit-line fr-pr-0"
      | .

    - creneaux_search = @rdv_invitation.creneaux_search(Time.zone.now)
    - creneaux = creneaux_search.creneaux

    - if creneaux.count > 0
      = render "admin/rdv_invitations/creneaux_preview", creneaux:

    - else
      p Il n'y a pas de créneau disponible pour ce motif.
      = link_to "Ajouter des plages d'ouverture", admin_organisation_planning_plage_ouvertures_path(current_organisation, { agent_id: current_agent.id }), class: "fr-btn fr-btn--secondary fr-mb-4w"

    .fr-col-12.fr-mt-2w.d-flex.rdv-justify-content-space-between
      = link_to "Retour", edit_motif_admin_organisation_rdv_invitation_path(current_organisation, @rdv_invitation), class: "fr-btn fr-btn--tertiary fr-btn--icon-left fr-icon-arrow-left-line"
      - if creneaux.any?
        = form_for @rdv_invitation, url: confirm_and_send_admin_organisation_rdv_invitation_path(current_organisation, @rdv_invitation), method: :patch, builder: Dsfr::FormBuilder do |f|
          = f.submit "Envoyer l'invitation", class: "fr-btn"
