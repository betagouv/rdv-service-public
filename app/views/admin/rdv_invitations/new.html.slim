- content_for :tab_title do
  | Invitation à prendre rendez-vous

.fr-grid-row
  .fr-col-12.fr-col-md-10.fr-col-offset-md-1
    h1.fr-h2.fr-pt-2w Invitation à prendre rendez-vous
    = render "common/stepper", step_count: 3, current_step: 1, step_title: "Usager", next_step_title: "Motif"
    .card.card-body.fr-p-2w
      = label_tag :user_id, "Qui souhaitez-vous inviter ?"
      span.fr-text-mention--grey.fr-text--sm Cherchez un usager par nom, prénom, téléphone, ou email

      .d-flex.js-rdv-invitation-user-picker
        .flex-grow-1.fr-pr-2w.fr-mb-8w
          .fr-mr-2w
            = select_tag :user_id,
              options_for_select([]),
              class: "js-rdv-invitation-user-picker__select",
              data: { url: search_agents_users_path(organisation_id: current_organisation.id) }
            = form_for @rdv_invitation, url: admin_organisation_rdv_invitations_path(current_organisation, @rdv_invitation), method: :post, html: { class: "js-rdv-invitation-user-picker__form"} do |f|
              = f.hidden_field :user_id

        div
          span.fr-text-mention--grey.fr-text--sm
            | Vous ne trouvez pas l'usager ?&nbsp;

          button[data-fr-opened="#{@user.present?}" aria-controls="new-user-modal" type="button" class="fr-btn fr-btn--sm fr-btn--tertiary-no-outline js-rdv-invitation-user-picker__new-user-btn"]
            | Ajouter un usager

dialog#new-user-modal.fr-modal[aria-labelledby="new-user-modal-title"]
  .fr-container.fr-container--fluid.fr-container-md
    .fr-grid-row.fr-grid-row--center
      .fr-col-12.fr-col-md-8
        .fr-modal__body
          .fr-modal__header
            button[aria-controls="new-user-modal" title="Fermer" type="button" class="fr-btn--close fr-btn"] Fermer
          .fr-modal__content.fr-mb-4w
            h2.fr-modal__title#new-user-modal-title
              = user_icon(class: "fr-mr-1w")
              | Nouvel usager
            - user = @user || User.new
            = form_for @rdv_invitation, url: admin_organisation_rdv_invitations_path(current_organisation, @rdv_invitation), method: :post, builder: Dsfr::FormBuilder do |f|
              = f.fields_for :user, User.new do |ff|
                .fr-grid-row.fr-grid-row--gutters
                  .fr-col-6
                    = ff.dsfr_text_field :first_name, required: true
                  .fr-col-6
                    = ff.dsfr_text_field :last_name, required: true
                  .fr-col-6
                    = ff.dsfr_email_field :email, required: true, autocomplete: "off"
                  .fr-col-6
                    = ff.dsfr_phone_field :phone_number, as: :tel
              .fr-btns-group.fr-btns-group--right.fr-mt-4w
                = f.submit "Enregistrer", class: "fr-btn"
