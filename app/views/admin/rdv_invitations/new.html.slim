- content_for :title do
  | Invitation à prendre rendez-vous

.fr-grid-row.justify-content-center
  .fr-col-md-12.col-lg-8
    .card.card-body
      = form_for [:admin, current_organisation, @rdv_invitation], builder: Dsfr::FormBuilder do |f|
        = f.hidden_field :user_id
        = f.hidden_field :motif_id
        = f.hidden_field :lieu_id
        = render "model_errors", model: @rdv_invitation, f: f

        - if @rdv_invitation.user.blank?
          = select_tag :status,
            options_for_select([]),
            required: true,
            class: "select2-input js-rdv-invitation-user-select",
            data: { \
              width: :style,
              "select2-config": { ajax: { url: search_agents_users_path(organisation_id: @rdv_invitation.organisation.id), dataType: "json", delay: 250}, placeholder: "Nom, prénom, téléphone, ou email" } }

        - elsif @rdv_invitation.lieu
          p Vous allez inviter <b>#{@rdv_invitation.user.full_name}</b> à prendre rendez-vous pour #{@rdv_invitation.motif.name}</b> à <b>#{@rdv_invitation.lieu.name}</b>.
        - else
          p Vous allez inviter <b>#{@rdv_invitation.user.full_name}</b> à prendre rendez-vous pour #{@rdv_invitation.motif.name}</b>.

        - if @rdv_invitation.user.present?
          = f.submit "Envoyer l'invitation", class: "fr-btn"

- redirect_path = new_admin_organisation_rdv_invitation_path(current_organisation, motif_id: @rdv_invitation.motif.id, lieu_id: @rdv_invitation.lieu.id)
input type="hidden" name="js-canonical-path" value=redirect_path
