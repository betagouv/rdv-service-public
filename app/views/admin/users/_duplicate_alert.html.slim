ruby:
  existing_attributes = attributes.map { User.human_attribute_name(_1) }.map(&:downcase).join(", ")
  return_location ||= admin_organisation_user_path(current_organisation, user)
  from_modal ||= false
  duplicate_is_within_current_org = user.organisations.load.include?(current_organisation)

div
  .fr-mb-2w
    - if duplicate_is_within_current_org
      span>= "Un usager avec le même #{existing_attributes} a déjà une fiche au sein de l'organisation :"
    - else
      span>= "Un usager avec le même #{existing_attributes} a déjà une fiche au sein de l'espace #{current_organisation.territory.name_for_agent} :"

  div
    p
      = icon("fr-icon-user-fill", class: "fr-icon--sm fr-mr-1w")
      = full_name_and_birthdate(user)

    p
      span.fr-mr-2w
        - if user.email.present?
          =< user.email
        - else
          i.fr-text-mention--grey Pas d'adresse email

        = " - "

        - if user.phone_number.present?
          =< user.phone_number
        - else
          i.fr-text-mention--grey Pas de téléphone

    - if user.address
      p
        span.fr-text-mention--grey Adresse :
        span =< user.address

    - unless duplicate_is_within_current_org
      div
        .fr-text-mention--grey Organisations :
        ul
          - user.organisations.each do |organisation|
            li = organisation.name

  div.fr-my-2w
    - if duplicate_is_within_current_org
      - if from_modal
        = link_to "Choisir cet usager", add_query_string_params_to_url(return_location, "user_ids[]": user.id), class: "fr-btn fr-btn--secondary"
      - else
        = link_to "Modifier cet usager", edit_admin_organisation_user_path(current_organisation, user), class: "fr-btn fr-btn--secondary"
    - else
      ruby:
        secure_key = nil
        secure_key = SecureRandom.uuid
        redis_key = "link_to_organisation:secure_key:#{secure_key}"
        Redis.with_connection do |redis|
          redis.set(redis_key, user.id.to_s, ex: 30.seconds)
        end
      = link_to "Importer cette fiche dans #{current_organisation.name}", link_to_organisation_admin_organisation_user_path(current_organisation, user, return_location: return_location, modal: from_modal, secure_key:), class: "fr-btn fr-btn--secondary"
