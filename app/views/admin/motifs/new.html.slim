- page_title = @motif.duplicated_from_motif ? %(Duplication du motif "#{@motif.duplicated_from_motif}") : t("motifs.form.title.new")
- content_for :title, page_title

= render "admin/motifs/fil_ariane", current_page_title: content_for(:title)

.fr-grid-row.justify-content-center
  .fr-col-lg-8
    = form_for @motif, url: admin_organisation_motifs_path, builder: Dsfr::FormBuilder, html: { "data-controller": "motif-form" } do |f|
      = render "model_errors", model: @motif, f: f
      = render "admin/motifs/form/configuration_principale", f: f, motif: @motif
      .fr-grid-row.fr-col.text-right
        = f.submit("Créer le motif", class: "fr-btn")
