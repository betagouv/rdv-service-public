- motif_policy = policy(motif, policy_class: Agent::MotifPolicy)

tr
  td.fr-pr-0.fr-py-2w.fr-pb-0
    span.fr-icon-circle-fill style="color: #{motif.color};" &nbsp;
  td.fr-p-0
    / On agrandit la taille du lien pour faciliter le click
    = link_to admin_organisation_motif_path(motif.organisation, motif), style: "width: 100%; min-height: 48px;", class: "fr-btn fr-btn--tertiary-no-outline fr-m-0" do
      =  motif.name
      = motif_badges(motif, only: %i[for_secretariat follow_up collectif])
  td
    = motif_badges(motif, only: %i[bookable_by_everyone bookable_by_agents_and_prescripteurs bookable_by_invited_users])
  - if display_sectorisation_level?
    td
      - if !motif.bookable_outside_of_organisation? || motif.follow_up?
        | &nbsp;
      - elsif motif.sectorisation_level_departement?
        | Tout le #{current_organisation.departement_number}
      - elsif motif.sectorisation_level_organisation?
        = t("motifs.index.sectorisation_level_organisation", count: Sector.attributed_to_organisation(current_organisation).count)
      - elsif motif.sectorisation_level_agent?
        - counts = SectorAttribution.level_agent_grouped_by_service(current_organisation).fetch(motif.service_id, {agents_count: 0})
        = t("motifs.index.sectorisation_level_agent", count: counts[:agents_count], sectors_count_human: \
            t("motifs.index.sectorisation_level_organisation", count: counts[:sectors_count]))

  - if @display_services
    td= motif.service_short_name
  td= motif.human_attribute_value(:location_type)
  td= "#{motif.default_duration_in_min} min."
  td.fr-pb-0
    .fr-btns-group.fr-btns-group--sm.fr-btns-group--inline
      - if @current_tab != :archived
        - if motif_policy.edit?
          = icon_link_to t("admin.motifs.actions.edit"), edit_admin_organisation_motif_path(current_organisation, motif),
                  class: "fr-btn fr-btn--tertiary fr-icon-edit-fill"
        - if motif_policy.duplicate?
          = icon_link_to t("admin.motifs.actions.duplicate"), new_admin_organisation_motif_path(current_organisation, duplicated_from_motif_id: motif.id),
                  class: "fr-btn fr-btn--tertiary fr-icon-clipboard-fill"

      - if motif.archived?
        - if motif_policy.unarchive?
          = icon_link_to t("admin.motifs.actions.unarchive"), unarchive_admin_organisation_motif_path(current_organisation, motif),
                  class: "fr-btn fr-btn--tertiary fr-icon-upload-fill",
                  method: :post
        - if motif_policy.destroy?
          - if motif.destroyable?
            = icon_link_to t("admin.motifs.actions.destroy"), admin_organisation_motif_path(current_organisation, motif),
                    class: "fr-btn fr-btn--tertiary fr-icon-delete-fill",
                    method: :delete,
                    data: { confirm: t("admin.motifs.actions.destroy_confirm") }
          - else
            button.fr-btn.fr-btn--tertiary.fr-icon-delete-fill [disabled="disabled" title=t("admin.motifs.actions.not_destroyable_explanation")]
              span.fr-sr-only= t("admin.motifs.actions.not_destroyable_explanation")
      - else
        - if motif_policy.archive?
          = icon_link_to t("admin.motifs.actions.archive"), archive_admin_organisation_motif_path(current_organisation, motif),
                  class: "fr-btn fr-btn--tertiary fr-icon-archive-fill",
                  method: :post,
                  data: { confirm: t("admin.motifs.actions.archive_confirm") }
