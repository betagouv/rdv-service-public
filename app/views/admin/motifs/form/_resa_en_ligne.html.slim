.card#bookable_by_section
  .card-body
    ruby:
      bookable_by_options = [
        {
          value: :agents,
          label: sanitize(I18n.t("activerecord.attributes.motif/bookable_by/radio_label_html.agents")),
          hint: sanitize(I18n.t("activerecord.attributes.motif/bookable_by/hint.agents")),
          checked: motif.bookable_by == "agents" || motif.new_record?,
        },
        {
          value: :agents_and_prescripteurs,
          label: sanitize(I18n.t("activerecord.attributes.motif/bookable_by/radio_label_html.agents_and_prescripteurs")),
          hint: sanitize(I18n.t("activerecord.attributes.motif/bookable_by/hint.agents_and_prescripteurs"), scrubber: :prune),
          checked: motif.bookable_by == "agents_and_prescripteurs",
        },
        {
          value: :everyone,
          label: sanitize(I18n.t("activerecord.attributes.motif/bookable_by/radio_label_html.everyone")),
          hint: sanitize(I18n.t("activerecord.attributes.motif/bookable_by/hint.everyone")),
          checked: motif.bookable_by == "everyone",
        },
      ]
      if rdvi_mode
        bookable_by_options.insert(2,
          {
            value: :agents_and_prescripteurs_and_invited_users,
            label: sanitize(I18n.t("activerecord.attributes.motif/bookable_by/radio_label_html.agents_and_prescripteurs_and_invited_users")),
            hint: sanitize(I18n.t("activerecord.attributes.motif/bookable_by/hint.agents_and_prescripteurs_and_invited_users")),
            checked: motif.bookable_by == "agents_and_prescripteurs_and_invited_users",
          })
      end
    = f.dsfr_radio_buttons :bookable_by, bookable_by_options, hint: Motif.human_attribute_name("bookable_by_hint"), "data-action": "change->motif-form#refreshSections", "data-motif-form-target": "bookableByRadios"

.card.collapse [data-motif-form-target="bookingDelaySection"]
  .card-body
    fieldset.fr-fieldset
      legend.fr-fieldset__legend--regular.fr_fieldset__legend
        = Motif.human_attribute_name("booking_delay")
        span.fr-hint-text
          = Motif.human_attribute_name("booking_delay_hint")
      .fr-fieldset__element.fr-mt-2w
        = f.dsfr_select :min_public_booking_delay, min_max_delay_options, label: "Délai minimum avant le RDV"
      .fr-fieldset__element.fr-mt-2w
        = f.dsfr_select :max_public_booking_delay, min_max_delay_options, label: "Délai maximum avant le RDV"
      .fr-fieldset__element.fr-mt-2w
        = f.dsfr_check_box :rdvs_editable_by_user, class: "js-check-on-section-enable js-uncheck-on-section-disable"
        .text-muted.font-14= Motif.human_attribute_name("rdvs_editable_by_user_hint")

.card
  .card-body
    fieldset.fr-fieldset
      legend.fr-fieldset__legend--regular.fr-fieldset__legend
        = Motif.human_attribute_name("follow_up_short")
        span.fr-hint-text
          = Motif.human_attribute_name("follow_up_warning")
      = f.dsfr_check_box :follow_up, "data-action": "change->motif-form#refreshSections", "data-motif-form-target": "followUpCheckbox"

.card.collapse [data-motif-form-target="secretariatSection"]
  .card-body
    fieldset.fr-fieldset
      legend.fr-fieldset__legend--regular.fr-fieldset__legend
        = Motif.human_attribute_name("for_secretariat_short")
        span.fr-hint-text
          = Motif.human_attribute_name("for_secretariat_hint")
      = f.dsfr_check_box :for_secretariat, label: Motif.human_attribute_name("for_secretariat_label"), class: "js-uncheck-on-section-disable"

- if current_territory.motif_categories.present?
  .card
    .card-body
      = f.dsfr_select :motif_category_id, current_territory.motif_categories.collect { |motif_categorie| [motif_categorie.name, motif_categorie.id] }, label: MotifCategory.model_name.human, hint: MotifCategory.human_attribute_name("category_hint"), include_blank: "Aucune"

- unless current_domain.online_reservation_with_public_link
  .card.collapse [data-motif-form-target="sectoSection"]
    .card-body
      ruby:
        if motif.organisation
          sectors_attributed_to_orga = Sector.attributed_to_organisation(motif.organisation)
          level_organisation_hint = t("motifs.form.sectorisation_level.sectors_attributed_to_orga", count: sectors_attributed_to_orga.count, sectors: sectors_attributed_to_orga.map(&:name).to_sentence.truncate(100), organisation: motif.organisation.name)
        end
        if motif.service && motif.organisation
          attributions_group = SectorAttribution.level_agent_grouped_by_service(motif.organisation).fetch(motif.service_id, {agents_count: 0, attributions: []})
          level_agent_hint = t( \
            "motifs.form.sectorisation_level.sectors_attributed_to_agents", \
            count: attributions_group[:agents_count], \
            service: motif.service.name, \
            sectors_count_human: t("motifs.index.sectorisation_level_organisation", count: attributions_group[:sectors_count]), \
            sectors: attributions_group[:attributions].map { "#{_1.agent.full_name_or_email} -> #{_1.sector.name}" }.to_sentence.truncate(100) \
          )
        end
        sectorisation_level_options = [
          {
            value: Motif::SECTORISATION_LEVEL_DEPARTEMENT,
            label: Motif.human_attribute_value(:sectorisation_level, Motif::SECTORISATION_LEVEL_DEPARTEMENT, context: :hint),
            checked: motif.sectorisation_level == Motif::SECTORISATION_LEVEL_DEPARTEMENT || motif.new_record?,
          },
          {
            value: Motif::SECTORISATION_LEVEL_ORGANISATION,
            label: Motif.human_attribute_value(:sectorisation_level, Motif::SECTORISATION_LEVEL_ORGANISATION, context: :hint),
            hint: level_organisation_hint,
            checked: motif.sectorisation_level == Motif::SECTORISATION_LEVEL_ORGANISATION,
          },
          {
            value: Motif::SECTORISATION_LEVEL_AGENT,
            label: Motif.human_attribute_value(:sectorisation_level, Motif::SECTORISATION_LEVEL_AGENT, context: :hint),
            hint: level_agent_hint,
            checked: motif.sectorisation_level == Motif::SECTORISATION_LEVEL_AGENT,
          },
        ]
      = f.dsfr_radio_buttons :sectorisation_level, sectorisation_level_options, label: Motif.human_attribute_name("sectorisation_level_title"), hint: sanitize("#{Motif.human_attribute_name('sectorisation_level_hint')} #{link_to('Voir la documentation concernant la sectorisation', 'https://doc.rdv-solidarites.fr/guide-utilisation/pour-un-territoire/sectorisation-geographique/', target: '_blank')}")

      - if current_agent.territorial_admin_in?(current_territory)
        = link_to "Configuration des secteurs", admin_territory_sectors_path(current_territory), class: "fr-btn fr-btn--tertiary"
