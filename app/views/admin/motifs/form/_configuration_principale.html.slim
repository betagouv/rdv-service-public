= f.hidden_field :duplicated_from_motif_id
- organisations_i_can_manage = Agent::MotifPolicy.organisations_i_can_manage(current_agent)
- if motif.duplicated_from_motif && motif.new_record? && organisations_i_can_manage.count > 1
  .card
    .card-body
      = f.dsfr_select :organisation_id, organisations_i_can_manage.sort.collect { |organisation| [organisation.name, organisation.id] }, label: "Créer le motif dans cette organisation", required: true

.card
  .card-body
    .fr-grid-row.fr-grid-row--gutters
      .fr-col-md-12
        datalist#motif_names
          - Motif.where(organisation_id: current_agent.organisations).map(&:name).uniq.each do |org_name|
            option= org_name
        / Nous voulons que l'autocomplete ne propose que les noms des motifs en base,
        / pas celles de l'historique de saisie du navigateur, d'où le autocomplete="off".
        = f.dsfr_text_field :name, label: "Nom du motif", input_html: { list: "motif_names", autocomplete: "off" }, required: false
      - available_services = (current_territory.services.reject(&:secretariat?) + [motif.service].compact)
      - if available_services.any? || motif.service_id.present?
        .fr-col-md-12
          = f.dsfr_select :service, available_services, label: "Service associé", include_blank: true, hint: "Optionnel"
        .fr-col-md-6= f.dsfr_number_field :default_duration_in_min, label: "Durée du RDV (en minutes)"
        // Le DSFR ne propose pas d’input color, on utilise donc le champ classique avec le style DSFR pour lequel on fixe la hauteur.
        .fr-col-md-6= f.dsfr_input_field :color, :color_field, label: "Couleur associée", style: "height: 2.5rem"

.card
  .card-body
    = render partial: "admin/motifs/form/location_types", locals: { f: f, disabled: motif.rdvs.any? }

.card
  .card-body
    - disabled = motif.rdvs.any?

    = f.dsfr_radio_buttons :collectif, [{ value: false, checked: !@motif.collectif, label: Motif.human_attribute_value(:collectif, false), hint: Motif.human_attribute_value(:collectif, false, context: :hint) }, { value: true, checked: @motif.collectif, label: Motif.human_attribute_value(:collectif, true), hint: Motif.human_attribute_value(:collectif, true, context: :hint) }], disabled: disabled, hint: "Choisissez le nombre de participants"
    - if disabled
      = dsfr_alert type: :warning, size: :sm, html_attributes: { class: "fr-mb-2v" } do
        | Ce motif est déjà utilisé dans au moins un RDV, il n'est pas possible de changer le nombre de participants
