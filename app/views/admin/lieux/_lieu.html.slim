.fr-tile.fr-tile--horizontal.fr-enlarge-link.fr-tile--sm.fr-mb-2w.fr-pt-2w.fr-pb-0.fr-col-8
  .fr-tile__body
    .fr-tile__content
      h3.fr-tile__title
        = link_to edit_admin_organisation_lieu_path(current_organisation, lieu) do
          .d-flex
            = lieu.name
      .fr-tile__desc[style="width: 100%"]
        .fr-grid-row
          .fr-col-6
            = lieu.address
          .fr-col-6
            = lieu.humanized_phone_number
      - if lieu.disabled?
        .fr-tile-start
          p.fr-badge.fr-badge--purple-glycine.fr-mb-0 Fermé
.fr-col-4
