- content_for(:title) { "Support" }
- content_for(:menu_item) { "menu-support" }

.row
  .col-md-6
    .card
      .card-header
        h5.card-title
          span> Documentation
          i.fa.fa-book
      .card-body
        p
          span> Explorez les fonctionnalités de l'outil à travers la
          = link_to "documentation", current_domain.documentation_url, target: "_blank"

    .card
      .card-header
        h5.card-title
          span> Contacter l'équipe technique
          i.fa.fa-question-circle
      .card-body
        = link_to "Envoyer une demande à l’équipe technique",
          new_aide_demande_support_path(role: "agent", sujet: "Question"),
          class: "fr-btn fr-btn--icon-left fr-icon-chat-3-line"

    .card
      .card-header
        h5.card-title
          span> État des serveurs
          i.fa.fa-signal
      .card-body
        = render "admin/static_pages/instatus_iframe"

  .col-md-6
    .card
      .card-header
        h5.card-title
          span> Documents
          i.fa.fa-file-alt
      .card-body
        ul
          li= link_to mentions_legales_path do
            span> Mentions Légales
          li= link_to cgu_path do
            span> C.G.U.
          li= link_to politique_de_confidentialite_path do
            span> Politique de confidentialité
