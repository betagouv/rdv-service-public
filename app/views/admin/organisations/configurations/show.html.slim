- content_for :title do
  = settings_icon(class: "fr-mr-1w")
  | Configuration
  - unless current_agent.admin_in_organisation?(current_organisation)
    .fr-badge.fr-icon-lock-fill.fr-badge--icon-left.fr-ml-2w
      | Lecture seule

= render "admin/onboarding/banner"

.fr-container-fluid
  .fr-grid-row.fr-grid-row--gutters

    .fr-col-12.fr-col-md-4.fr-mb-2w
      .fr-tile.fr-tile--horizontal.fr-enlarge-link.fr-tile--md
        .fr-tile__body
          .fr-tile__content
            h2.fr-tile__title
              = link_to(admin_organisation_motifs_path(current_organisation)) do
                = motif_icon(class: "fr-mr-1w")
                | Motifs de rendez-vous
            div.fr-tile__desc
              - if @motif_names.blank?
                i.fr-text-mention--grey Aucun motif
                br
                p.fr-badge.fr-badge--info.fr-mt-1w À renseigner
              - else
                = @motif_names[0..2].join(", ")
                - if @motif_names.count > 3
                  - autres_count = @motif_names.count - 3
                  = " et #{autres_count} #{'autre'.pluralize(autres_count)}"

    .fr-col-12.fr-col-md-4.fr-mb-2w
      .fr-tile.fr-tile--horizontal.fr-enlarge-link.fr-tile--md
        .fr-tile__body
          .fr-tile__content
            h2.fr-tile__title
              = link_to(admin_organisation_lieux_path(current_organisation)) do
                = lieu_icon(class: "fr-mr-1w")
                | Lieux
            div.fr-tile__desc
              - if @lieu_names.blank?
                i.fr-text-mention--grey Aucun lieu
                - if needs_lieu(current_organisation)
                  br
                  p.fr-badge.fr-badge--info.fr-mt-1w À renseigner
              - else
                = @lieu_names[0..2].join(", ")
                - if @lieu_names.count > 3
                  - autres_count = @lieu_names.count - 3
                  = " et #{autres_count} #{'autre'.pluralize(autres_count)}"

    .fr-col-12.fr-col-md-4.fr-mb-2w
      .fr-tile.fr-tile--horizontal.fr-enlarge-link.fr-tile--md
        .fr-tile__body
          .fr-tile__content
            h2.fr-tile__title
              = link_to(admin_organisation_agents_path(current_organisation)) do
                = icon("fr-icon-user-fill",class: "fr-mr-1w")
                | Agents
            p.fr-tile__desc
              = @agents_scope.limit(3).map(&:full_name_or_email).join(", ")
              - if @agents_scope.count > 3
                - autres_count = @agents_scope.count - 3
                = " et #{autres_count} #{'autre'.pluralize(autres_count)}"

    .fr-col-12.fr-col-md-4.fr-mb-2w
      .fr-tile.fr-tile--horizontal.fr-enlarge-link.fr-tile--md
        .fr-tile__body
          .fr-tile__content
            h2.fr-tile__title
              = link_to("Réservation en ligne", admin_organisation_online_booking_path(current_organisation))

    .fr-col-12.fr-col-md-4.fr-mb-2w
      .fr-tile.fr-tile--horizontal.fr-enlarge-link.fr-tile--md
        .fr-tile__body
          .fr-tile__content
            h2.fr-tile__title
              = link_to("Informations de l'organisation", admin_organisation_path(current_organisation))
            p.fr-tile__desc
              = @organisation.name
              br
              - infos =[@organisation.phone_number, @organisation.email, @organisation.website].compact
              - if infos.present?
                = infos.join(" ")
              - else
                i.fr-text-mention--grey Pas d'informations de contact

      - if current_agent.admin_in_organisation?(current_organisation) && current_domain == Domain::RDV_AIDE_NUMERIQUE
        .fr-col-12.fr-col-md-4.fr-mb-2w
          .fr-tile.fr-tile--horizontal.fr-enlarge-link.fr-tile--md
            .fr-tile__body
              .fr-tile__content
                h2.fr-tile__title
                  = link_to("Migration vers RDV Service Public", admin_organisation_instance_exports_path(current_organisation))

- unless current_agent.admin_in_organisation?(current_organisation)
  .fr-callout.fr-mt-4w
    .fr-callout__title.fr-text--lg
      | Besoin de modifier un paramètre ?
    div.fr-text--sm
      |> En tant qu'agent, vous avez un accès en
      b lecture seule
      |> .
      |> Pour modifier les motifs, les lieux, la réservation en ligne ou pour inviter de nouveaux agents, veuillez contacter un administrateur de votre organisation.
    = link_to "Voir la liste des administrateurs", admin_organisation_agents_path(current_organisation, search: { role: "admin" }), class: "fr-btn fr-btn--secondary fr-btn--sm"

  / Un bricolage pour éviter que le footer déborde sur les tuiles
  br.fr-my-2w
  br.fr-my-2w
