.rdv-text-align-center.m-auto
  h4.text-dark-50.rdv-text-align-center.mt-0.font-weight-bold.mb-4 Ajouter une organisation

  = render "model_errors", model: @organisation

  .card
    .card-body
      = simple_form_for [:admin, @organisation] do |f|
        = f.input :name, label: "Nom de votre organisation", placeholder: "Maison départementale des solidarités de Beaupréau-en-Mauges"
        = f.association :territory, \
          label: "Espace", \
          collection: [@organisation.territory], \
          include_blank: false, \
          readonly: true, \
          label_method: -> { _1.name_for_agent.capitalize }
        = f.submit value: "Enregistrer", class: "fr-btn"
