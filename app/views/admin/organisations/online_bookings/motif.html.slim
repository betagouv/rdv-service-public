- titles_and_paths = [["Accueil", root_path], ["Configuration", admin_organisation_configuration_path(current_organisation)], ["Réservation en ligne", admin_organisation_online_booking_path(current_organisation)]]

- content_for :fil_ariane do
  = render "common/fil_ariane", titles_and_paths: titles_and_paths, current_page_title: @motif.name

- content_for(:menu_item) { "menu-settings" }

- count = @motif.upcoming_availabilities.count

- content_for :title do
  | #{@motif.name}
  = render "availability_badge", motif: @motif, availabilities_count: count

.fr-grid-row
  .fr-col-12.fr-col-lg-10
    - if @motif.bookable_by_everyone? && count == 0
      .fr-callout.fr-pb-2w
        - if @motif.individuel?
          p Ce motif est ouvert à la réservation en ligne, mais il n'a pas de plage d'ouverture disponible.
          p Vous devez ouvrir une plage d'ouverture pour permettre la réservation en ligne sur ce motif.
          = link_to "Ouvrir une plage d'ouverture", admin_organisation_planning_plage_ouvertures_path(current_organisation), class: "fr-btn"

    - unless @motif.bookable_by_everyone?
      .card
        .card-body
          / TODO: gérer les autres niveaux de réservation
          p Ce motif n'est pas ouvert à la réservation en ligne
          .fr-btns-group.fr-btns-group--inline
            = link_to "Ouvrir à la réservation en ligne", "#", class: "fr-btn"

    - if @motif.bookable_outside_of_organisation?
      .card
        .card-body
          .d-flex.rdv-justify-content-space-between.rdv-align-items-baseline
            h3.fr-h4 Options de réservation
            = link_to "Modifier", edit_online_booking_admin_organisation_motif_path(@organisation, @motif.id), class: "fr-btn fr-btn--secondary"

          ul
            li.fr-my-2w Les rendez-vous seront pris au moins #{ min_max_delay_int_to_human(@motif.min_public_booking_delay) } à l'avance.
            li.fr-my-2w Ils seront pris au maximum #{ min_max_delay_int_to_human(@motif.max_public_booking_delay) } à l'avance.

            - if @motif.rdvs_editable_by_user
              li.fr-my-2w Les usagers sont autorisés à déplacer le rendez-vous jusqu'à 48 heures avant qu'il commence.
            - else
              li.fr-my-2w Les usagers ne sont pas autorisés à déplacer le rendez-vous.

        - if !current_domain.online_reservation_with_public_link && !@motif.follow_up?
          / TODO: voir la tête que ça a pour la résa en ligne
          = motif_attribute_row("Sectorisation") do
              div= @motif.human_attribute_value(:sectorisation_level)
              div.text-muted= @motif.human_attribute_value(:sectorisation_level, context: :hint)

    - if @motif.bookable_by_everyone?
      .card
        .card-body
          h3.fr-h4 Niveau d'ouverture
          p Ce motif est ouvert à la réservation en ligne. Tous les usagers qui ont accès à votre lien peuvent prendre des rendez-vous.
          / TODO: peut-être qu'on garde prescripteurs et usagers invités pour plus tard.
          .fr-btns-group.fr-btns-group--inline
            = link_to "Fermer la réservation en ligne", "#", class: "fr-btn fr-btn--secondary"
