- content_for(:title) do
  | Nouveau RDV par prescription

main.container
  .fr-grid-row.justify-content-center.mt-4
    .fr-col-lg-7.fr-col-md-10.fr-col-sm-11
      .card
        .card-body
          h2.fr-h3 Récapitulatif

          = render "users/rdv_wizard_steps/rdv_wizard_summary", rdv_wizard: @rdv_wizard

          ul.list-group.list-group-flush[style="border-top: 1px solid #e3eaef;"]
            li.list-group-item
              .fr-grid-row
                .fr-col
                  = icon("fr-icon-check-line", class: "fr-mr-1w rdv-color-text-default-success")
                  | Usager :&nbsp;
                  = UsersHelper.reverse_full_name_and_notification_coordinates(@rdv_wizard.participation.user)
                .fr-col-auto
                  = link_to "modifier", user_selection_admin_organisation_prescription_path(@rdv_wizard.query_params), title: "Modifier l'usager"
            - if current_territory.enable_context_field
              li.list-group-item
                .fr-grid-row
                  .fr-col
                    = icon("fr-icon-check-line", class: "fr-mr-1w rdv-color-text-default-success")
                    |> Contexte :
                    = @rdv_wizard.context&.strip&.truncate_words(6)&.presence || "N/A"
                  .fr-col-auto
                    = link_to "modifier", user_selection_admin_organisation_prescription_path(@rdv_wizard.query_params), title: "Modifier le contexte"

          .fr-grid-row.mt-2
            .fr-col.text-right
              = button_to("Confirmer le rdv", create_rdv_admin_organisation_prescription_path(@rdv_wizard.query_params), method: :post, class: "fr-btn", data: { disable_with: "Veuillez patienter…"})
