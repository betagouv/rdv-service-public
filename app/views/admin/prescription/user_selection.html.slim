- content_for(:title) do
  | Nouveau RDV par prescription
main.container
  .row.justify-content-center.mt-4
    .col-lg-8.col-md-10.col-sm-11
      .card
        .card-body
          = render "users/rdv_wizard_steps/rdv_booking_summary", rdv_booking_form: @rdv_wizard

          hr.my-0.pb-3
          h2.fr-h4 Pour quel usager prenez-vous RDV ?
          = form_with(url: recapitulatif_admin_organisation_prescription_path(organisation_id: current_organisation.id), html: { method: :get }) do |f|

            = render "admin/prescription/hidden_fields", attributes_to_hide: @rdv_wizard.query_params.except(:user_ids)

            .form-row.grid-align-center.mb-3
              .flex-grow-1.pr-3
                = select_tag :"user_ids[]",
                        options_for_select(@rdv_wizard.users&.map { [UsersHelper.reverse_full_name_and_notification_coordinates(_1), _1.id] } || []),
                        required: true,
                        class: "select2-input",
                        data: { \
                                width: "auto", \
                                "select2-config": { ajax: { url: search_agents_users_path(organisation_id: current_organisation.id, exclude_ids: @rdv_wizard.query_params[:user_ids]), dataType: "json", delay: 250 } }, \
                        }
              - return_url = url_for(@rdv_wizard.query_params.except(:user_ids))
              = render "admin/users/create_user_cta", path: new_admin_organisation_user_path(current_organisation, modal: true, return_location: return_url, role: default_service_selection_from(@rdv_wizard.rdv.motif.service))

            - if current_territory.enable_context_field
              .form-group.mt-3
                = f.label :context, Rdv.human_attribute_name(:context)
                = f.text_area :context,  rows: 4, class: "form-control", value: @rdv_wizard.context

            .form-group
              .float-right
                = submit_tag "Continuer", class: "fr-btn"
