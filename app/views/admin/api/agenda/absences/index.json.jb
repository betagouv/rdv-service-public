@absence_occurrences.map do |absence, occurrence|
  {
    title: sanitize(absence.title),
    start: occurrence.starts_at.as_json,
    end: occurrence.ends_at.as_json,
    backgroundColor: AbsencesHelper::CALENDAR_BACKGROUND_COLOR,
    url: edit_admin_organisation_planning_absence_path(@organisation, absence),

    # https://fullcalendar.io/docs/resources-and-events
    resourceIds: [absence.agent.id],
  }
end
