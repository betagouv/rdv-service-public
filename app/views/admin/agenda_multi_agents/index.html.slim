- content_for :title, "Agenda de #{@selected_agents.map(&:full_name_or_email).join(', ')}"

.fr-container
  .fr-grid-row
    .fr-col
      = form_with(url: admin_organisation_agenda_multi_agents_path ,method: :get) do |form|
        .rdv-flex
          - collection = @selectable_agents.map { [_1.full_name_or_email, _1.id] }
          = form.select :agent_ids, collection, { multiple: true, selected: @selected_agents.map(&:id) }, { class: "select2-input", style: "width: 80%" }
          = form.submit "Appliquer", { class: "fr-btn" }

ruby:
  event_sources = [
    admin_api_agenda_rdvs_path(agent_ids: @selected_agents.map(&:id), organisation_id: current_organisation.id, format: :json),
    admin_api_agenda_absences_path(agent_ids: @selected_agents.map(&:id), organisation_id: current_organisation.id, format: :json),
    admin_api_agenda_plage_ouvertures_path(agent_ids: @selected_agents.map(&:id), organisation_id: current_organisation.id, mixed_with_rdvs: true, format: :json),
  ]
  event_sources.push(OffDays.to_full_calendar_array) unless current_territory.visioplainte?
  resources = @selected_agents.map { { id: _1.id, title: _1.full_name_or_email } }

#agenda-multi-agent.mt-2[
  data-default-date-json="#{@date&.to_json}"
  data-event-sources-json="#{event_sources.to_json}"
  data-resources-json="#{resources.to_json}"
]
