- content_for :title do
  | RDV supprimés

- content_for :fil_ariane do
  = render "common/fil_ariane", titles_and_paths: [["Liste des RDV", admin_organisation_rdvs_path(current_organisation)]], current_page_title: "RDV supprimés"

p Cette page liste les RDV supprimés de l'organisation #{current_organisation.name}, du plus récent au plus ancien. Les informations qui n'existent plus (motif, lieu, usager ou agent supprimé) sont laissées vides.

- if @deleted_rdvs.total_count > 0
  .card
    .card-body
      .table-responsive
        table.table
          thead
            tr
              th Supprimé le
              th Date du RDV
              th Motif
              th Lieu
              th Statut
              th Usagers
              th Agents
              th Créé par
          tbody
            - @deleted_rdvs.each do |deleted_rdv|
              tr id="deleted_rdv_#{deleted_rdv.id}"
                td = l(deleted_rdv.deleted_at, format: :human)
                td
                  = l(deleted_rdv.starts_at, format: :human)
                  br
                  span.fr-text--xs.fr-mb-0 jusqu'à #{l(deleted_rdv.ends_at, format: :time_only)}
                td = deleted_rdv.motif_name
                td = deleted_rdv.lieu&.name
                td = Rdv.human_attribute_value(:status, deleted_rdv.status, disable_cast: true)
                td = safe_join(deleted_rdv.user_ids.filter_map { @users_by_id[_1]&.full_name }, tag.br)
                td = safe_join(deleted_rdv.agent_ids.filter_map { @agents_by_id[_1]&.full_name }, tag.br)
                td
                  - if deleted_rdv.created_by_type.present?
                    = Rdv.human_attribute_value(:created_by_type, deleted_rdv.created_by_type, disable_cast: true)
                    - if deleted_rdv.created_by.respond_to?(:full_name)
                      br
                      span.fr-text--xs.fr-mb-0 = deleted_rdv.created_by.full_name
  .d-flex.justify-content-center.fr-mt-2w
    = paginate @deleted_rdvs
- else
  .card
    .card-body.rdv-text-align-center.my-5
      p.mb-0 Aucun RDV supprimé.
