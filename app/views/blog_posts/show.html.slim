- content_for :title, @post.title

- content_for :breadcrumbs do
  = dsfr_breadcrumbs do |b|
    = b.with_breadcrumb label: "Accueil", href: root_path
    = b.with_breadcrumb label: "Nouveautés", href: blog_posts_path
    = b.with_breadcrumb label: @post.title

.fr-grid-row.fr-mb-6w
  .fr-col-12.fr-col-md-10.fr-col-lg-8
    article
      = render "blog_posts/blog_post_meta", post: @post

      .rdv-blog-post-content
        = sanitize @post.content_html, tags: BlogPost::CONTENT_HTML_ALLOWED_TAGS, attributes: BlogPost::CONTENT_HTML_ALLOWED_ATTRIBUTES

      = link_to "Toutes les nouveautés", blog_posts_path, class: "fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-arrow-left-line fr-mt-4w"
