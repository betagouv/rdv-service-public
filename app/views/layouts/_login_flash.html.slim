  if flash[:notice] == I18n.t("devise.sessions.signed_in")
    flash[:login_notice] = I18n.t("devise.sessions.signed_in")
    flash[:notice] = nil
  end

- sanitized_flash = sanitize(flash[:login_notice], tags: %w[a br strong em], scrubber: :prune).presence
- if sanitized_flash
  .fr-m-0.fr-px-2w.fr-pt-2w[style="background-color: white"]
    = dsfr_alert type: alert_dsfr_type_for(:notice), size: :sm, close_button: true, html_attributes: { class: "fr-pb-1w", role: "alert" } do
      = sanitized_flash
