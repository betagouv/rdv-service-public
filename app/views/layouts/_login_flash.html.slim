- sanitized_flash = sanitize(flash[:login_success], tags: %w[a br strong em], scrubber: :prune).presence
- if sanitized_flash
  .fr-m-0.fr-px-2w.fr-pt-2w[style="background-color: white"]
    = dsfr_alert type: alert_dsfr_type_for(:success), size: :sm, close_button: true, html_attributes: { class: "fr-pb-1w", role: "alert" } do
      = sanitized_flash
