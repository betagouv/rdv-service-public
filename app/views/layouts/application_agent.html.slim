doctype html
html lang="fr"
  head
    = yield :html_head_prepend
    = render "common/head_agent"
  body
    - links = [dsfr_link_to("Contenu", "#main"), link_to("Pied de page", "#footer")]
    = dsfr_skiplink label: "Accès rapide", links: links, html_attributes: { "data-turbolinks": "false" }

    = render "layouts/agent_header"
    / doit être dans <body> et pas dans <head>

    .content-and-left-menu-wrapper
      = render "layouts/left_menu"
      main#main.content-page[style="flex-grow: 1;" role="main"]
        .content
          - if @beta_planning_layout
            = content_for :onboarding_banner
            = render partial: "admin/planning/planning_agents_select"
            .p-3
              = content_for(:fil_ariane)
              = yield

          - else
            = render "layouts/instance_migration_banner"
            = content_for :fil_ariane
            .container-fluid
              = render "layouts/flash"
              = content_for :onboarding_banner
              - if content_for :title
                .page-title-box
                  h1.fr-h2= yield :title
                  // TODO: Nous sommes en train de migrer les breadcrumbs vers des fils d'ariane au DSFR qui sont au dessus du titre.
                  // Voir plus haut
                  // Une fois cette transition terminée il faudra renommer ce bloc qui continuera à être utilisé pour les boutons en haut de page (ou refacto).
                  - if content_for :breadcrumb
                    .page-title-right
                      = yield :breadcrumb
                  - if content_for :right_of_page_title
                    .page-title-right
                      = yield :right_of_page_title
              = yield

      = render "layouts/agent_footer"
    #modal-holder
