- content_for(:title) { "Demande d'ouverture d'espace" }

header.main-content__header
  h1.main-content__page-title
    = content_for(:title)

section.main-content__body
  p
    b = "Demandé par : "
    = @territory_creation_request.agent.full_name
    = " "
    = @territory_creation_request.agent.email

  p
    b = "Nom de l'espace : "
    = @territory_creation_request.territory_name

  p
    b = "Nom de l'organisation : "
    = @territory_creation_request.organisation_name

  p
    b = "Service demandé : "
    = @territory_creation_request.service_name

    - if @territory_creation_request.agent.proconnect_siret
      p
        b = "Siret de l'agent : "
        = @territory_creation_request.agent.proconnect_siret
      - agents_with_same_siret = Agent.joins(:organisations).where(agents: { proconnect_siret: @territory_creation_request.agent.proconnect_siret }).limit(10).distinct
      - if agents_with_same_siret.any?
        p D'autres agents ont le même siret :
        ul
          - agents_with_same_siret.each do |agent|
            li = link_to(agent.full_name, super_admins_agent_path(agent), target: :_blank)

  = "Avant d'accepter cette requête, pour éviter de créer des doublons, merci de faire les vérifications suivantes :"
  ul
    li Il n'y a pas d'autre territoire/espace avec un nom similaire
    li Il n'y a pas d'autres organisation avec un nom similaire
    li Il n'y a pas d'autres agents avec le même nom de domaine qui ont déjà un espace

  = simple_form_for([namespace, @territory_creation_request], html: { class: "form" }) do |f|
    = f.hidden_field :response, value: "refused"
    = f.submit "Refuser"

  = link_to("Accepter", new_super_admins_compte_path(request_id: @territory_creation_request.id), class: "btn")
