= f.dsfr_input_group :password, class: "fr-password fr-mt-2w", data: {component: "js_dsfr_new_password"}
  = f.dsfr_label_with_hint :password, class: "fr-label fr-password__label", hint: "Choisissez votre mot de passe"
  .fr-input-wrap
    = f.password_field :password, class: "fr-input fr-password__input"
    = f.dsfr_error_message :password
  .fr-password__checkbox.fr-checkbox-group.fr-checkbox-group--sm
    = f.check_box :password, id: "password-show", class: "fr-checkbox", aria: {label: "Afficher le mot de passe", describedby: "password-show-messages"}
    label.fr-password__checkbox.fr-label[for = "password-show"] Afficher
  - if defined?(live_validation) && live_validation
    = render "common/form/password_live_validation"
