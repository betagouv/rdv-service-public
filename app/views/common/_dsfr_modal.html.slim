/# locals: (id:, title:, body:, cancel_message:, confirm_message:, confirm_path:)

dialog.fr-modal id=id role="dialog" aria-labelledby="#{id}-title" data-fr-concealing-backdrop="true"
  .fr-container.fr-container--fluid.fr-container-md
    .fr-grid-row.fr-grid-row--center
      .fr-col-12.fr-col-md-8.fr-col-lg-6
        .fr-modal__body
          .fr-modal__header
            button.fr-btn--close.fr-btn aria-controls=id aria-label="Fermer" data-dismiss="modal" type="button" Fermer
          .fr-modal__content
            h2.fr-modal__title id="#{id}-title"
              = title
            p
              = body || yield
          .fr-modal__footer
            .fr-btns-group.fr-btns-group--right.fr-btns-group--inline-reverse.fr-btns-group--inline-lg.fr-btns-group--icon-left
              = link_to(confirm_message || "Accepter", confirm_path, class: "fr-btn fr-icon-checkbox-circle-line fr-btn--icon-left") if confirm_path.present?
              button.fr-btn.fr-icon-checkbox-circle-line.fr-btn--icon-left.fr-btn--secondary data-dismiss="modal" type="button" aria-controls=id
                = cancel_message || "Annuler"
