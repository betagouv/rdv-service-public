rdv_service_public_web: ./bin/rdv_service_public_development_run ./bin/start_web_server
rdv_solidarites_web: ./bin/rdv_service_public_development_run bundle exec dotenv -f ".env.rdv_solidarites,.env" ./bin/start_web_server
rdv_service_public_jobs: ./bin/rdv_service_public_development_run bundle exec good_job start
rdv_solidarites_jobs: bundle exec dotenv -f ".env.rdv_solidarites,.env" bundle exec good_job start
js: yarn build --mode=development --watch --progress
mss_web: PORT=3010 bundle exec ruby scripts/mon_suivi_social_local.rb
ants_web: PORT=3020 bundle exec ruby scripts/ants_app.rb
